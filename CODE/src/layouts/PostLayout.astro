---
import BaseLayout from './BaseLayout.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
import { categorySlug } from '../lib/categories';
import type { Category } from '../lib/categories';

interface Props {
  title: string;
  description: string;
  pubDate: Date;
  updatedDate?: Date;
  category: Category;
  readingTime?: string;
}
const { title, description, pubDate, updatedDate, category, readingTime } = Astro.props;

const base = import.meta.env.BASE_URL;
const withBase = (p: string) => `${base}${p}`.replace(/\/{2,}/g, '/');

const fmt = (d: Date) =>
  d.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });

// The blog archive/category pages are gone — those sections now live as in-page
// panels on the home page, addressed by hash (#writeups …).
const homeHref = withBase('/');
const sectionHref = `${homeHref}#${categorySlug(category)}`;
---

<BaseLayout title={title} description={description} themeToggle>
  <article class="post">
    <ThemeToggle />
    <div class="page">
      <p class="post__crumbs">
        <a class="link" href={homeHref}>Home</a>
        <span aria-hidden="true">/</span>
        <a class="link" href={sectionHref}>{category}</a>
      </p>

      <header class="post__head">
        <h1 class="post__title">{title}</h1>
        <p class="post__dek">{description}</p>
        <p class="post__meta tnum">
          <time datetime={pubDate.toISOString()}>{fmt(pubDate)}</time>
          {readingTime && <><span aria-hidden="true">·</span><span>{readingTime}</span></>}
          {updatedDate && (
            <><span aria-hidden="true">·</span><span>Updated {fmt(updatedDate)}</span></>
          )}
        </p>
      </header>

      <hr class="post__rule" />

      <div class="prose">
        <slot />
      </div>

      <hr class="post__rule post__rule--end" />
      <p class="post__back">
        <a class="chip" href={sectionHref}>
          <span aria-hidden="true">←</span> Back to {category}
        </a>
      </p>
    </div>
  </article>
</BaseLayout>

<style>
  .post {
    padding-block: var(--space-lg) 0;
  }
  .post__crumbs {
    display: flex;
    gap: var(--space-2xs);
    font-family: var(--font-display);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-muted);
  }
  .post__head {
    max-width: var(--measure);
    margin-top: var(--space-md);
  }
  .post__title {
    font-size: var(--text-3xl);
    font-weight: 800;
    line-height: 1.06;
    letter-spacing: -0.025em;
    text-wrap: balance;
  }
  .post__dek {
    margin-top: var(--space-sm);
    font-size: var(--text-md);
    line-height: 1.5;
    color: var(--color-ink-2);
    font-style: italic;
  }
  .post__meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2xs);
    margin-top: var(--space-md);
    font-family: var(--font-display);
    font-size: var(--text-sm);
    color: var(--color-muted);
  }
  .post__rule {
    max-width: var(--measure);
    margin: var(--space-lg) 0;
    margin-inline: 0;
  }
  .post__rule--end {
    margin-top: var(--space-2xl);
  }
  .post__back {
    margin-bottom: var(--space-lg);
  }
</style>
