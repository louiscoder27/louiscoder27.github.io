---
import BaseLayout from './BaseLayout.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
import TableOfContents from '../components/TableOfContents.astro';
// KaTeX stylesheet — bundled so `$…$` / `$$…$$` math renders on post pages.
import 'katex/dist/katex.min.css';
import { categorySlug } from '../lib/categories';
import type { Category } from '../lib/categories';
import type { TocEntry } from '../lib/toc';

interface Props {
  title: string;
  description: string;
  pubDate: Date;
  updatedDate?: Date;
  category: Category;
  toc?: TocEntry[];
}
const { title, description, pubDate, updatedDate, category, toc = [] } = Astro.props;

const base = import.meta.env.BASE_URL;
const withBase = (p: string) => `${base}${p}`.replace(/\/{2,}/g, '/');

const fmt = (d: Date) =>
  d.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });

// The blog archive/category pages are gone — those sections now live as in-page
// panels on the home page, addressed by hash (#vault …).
const homeHref = withBase('/');
const sectionHref = `${homeHref}#${categorySlug(category)}`;
---

<BaseLayout title={title} description={description} themeToggle>
  <article class="post">
    <ThemeToggle />
    <TableOfContents toc={toc} />
    <div class="page">
      <p class="post__crumbs">
        <a class="link" href={homeHref}>Home</a>
        <span aria-hidden="true">/</span>
        <a class="link" href={sectionHref}>{category}</a>
      </p>

      <header class="post__head">
        <h1 class="post__title">{title}</h1>
        <p class="post__dek">{description}</p>
        <p class="post__meta tnum">
          <time datetime={pubDate.toISOString()}>{fmt(pubDate)}</time>
          {updatedDate && (
            <><span aria-hidden="true">·</span><span>Updated {fmt(updatedDate)}</span></>
          )}
        </p>
      </header>

      <hr class="post__rule" />

      <div class="prose">
        <slot />
      </div>

      <hr class="post__rule post__rule--end" />
      <p class="post__back">
        <a class="chip" href={sectionHref}>
          <span aria-hidden="true">←</span> Back to {category}
        </a>
      </p>
    </div>
  </article>
</BaseLayout>

<script>
  // Render LaTeX written as $…$ (inline) / $$…$$ (display) in the article body.
  import renderMathInElement from 'katex/contrib/auto-render';

  function renderMath() {
    const prose = document.querySelector<HTMLElement>('.prose');
    if (!prose) return;
    renderMathInElement(prose, {
      delimiters: [
        { left: '$$', right: '$$', display: true },
        { left: '$', right: '$', display: false },
        { left: '\\[', right: '\\]', display: true },
        { left: '\\(', right: '\\)', display: false },
      ],
      // A malformed formula shows its source in red instead of blowing up the page.
      throwOnError: false,
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', renderMath);
  } else {
    renderMath();
  }
</script>

<style>
  .post {
    padding-block: var(--space-lg) 0;
    /* Whole article uses JetBrains Mono — cascades to title, dek, meta, prose. */
    font-family: var(--font-post);
  }
  /* Reading column: wider than the old --measure and centred on the page. */
  .post__crumbs,
  .post__head,
  .post__rule,
  .post__back {
    max-width: var(--post-measure);
    margin-inline: auto;
  }
  .post__crumbs {
    display: flex;
    gap: var(--space-2xs);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-muted);
  }
  .post__head {
    margin-top: var(--space-md);
  }
  .post__title {
    font-family: var(--font-post);
    font-size: var(--text-3xl);
    font-weight: 800;
    line-height: 1.06;
    letter-spacing: -0.025em;
    text-wrap: balance;
  }
  .post__dek {
    margin-top: var(--space-sm);
    font-size: var(--text-md);
    line-height: 1.5;
    color: var(--color-ink-2);
    font-style: italic;
  }
  .post__meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2xs);
    margin-top: var(--space-md);
    font-size: var(--text-sm);
    color: var(--color-muted);
  }
  .post__rule {
    margin: var(--space-lg) auto;
  }
  .post__rule--end {
    margin-top: var(--space-2xl);
  }
  .post__back {
    margin-bottom: var(--space-lg);
  }
  .post__back .chip {
    font-family: var(--font-post);
  }
</style>
