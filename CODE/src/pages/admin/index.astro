---
import BaseLayout from '../../layouts/BaseLayout.astro';

const supabase = Astro.locals.supabase!;
const user = Astro.locals.user;
const { data: posts } = await supabase
  .from('posts')
  .select('id, slug, title, category, published, pub_date, updated_at')
  .order('updated_at', { ascending: false });

const rows = posts ?? [];
const fmt = (s: string) =>
  new Date(s).toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'short',
    day: 'numeric',
  });
---

<BaseLayout title="Dashboard">
  <section class="dash page">
    <header class="dash__head">
      <div>
        <h1 class="dash__title">Posts</h1>
        <p class="dash__sub">Signed in as {user?.email}</p>
      </div>
      <div class="dash__head-actions">
        <a class="dash__new" href="/admin/edit/new">+ New post</a>
        <form method="POST" action="/api/auth/logout">
          <button class="dash__logout" type="submit">Sign out</button>
        </form>
      </div>
    </header>

    {rows.length === 0 && <p class="dash__empty">No posts yet. Create your first one.</p>}

    {rows.length > 0 && (
      <div class="dash__table-wrap">
        <table class="dash__table">
          <thead>
            <tr>
              <th>Title</th>
              <th>Category</th>
              <th>Status</th>
              <th>Updated</th>
              <th aria-label="actions"></th>
            </tr>
          </thead>
          <tbody>
            {rows.map((p) => (
              <tr data-id={p.id} data-published={String(p.published)}>
                <td class="dash__cell-title">
                  <a class="link" href={`/admin/edit/${p.id}`}>{p.title || '(untitled)'}</a>
                  <span class="dash__slug">/{p.slug}</span>
                </td>
                <td>{p.category}</td>
                <td>
                  <span class={`dash__badge ${p.published ? 'is-live' : 'is-draft'}`}>
                    {p.published ? 'Published' : 'Draft'}
                  </span>
                </td>
                <td class="tnum">{fmt(p.updated_at)}</td>
                <td class="dash__actions">
                  {p.published && (
                    <a class="dash__link" href={`/blog/${p.slug}`} target="_blank">View</a>
                  )}
                  <button class="dash__link" data-action="toggle">
                    {p.published ? 'Unpublish' : 'Publish'}
                  </button>
                  <button class="dash__link dash__link--danger" data-action="delete">Delete</button>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    )}
  </section>
</BaseLayout>

<script is:inline>
  document.querySelectorAll('button[data-action]').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const row = btn.closest('tr');
      const id = row.getAttribute('data-id');
      const action = btn.getAttribute('data-action');
      btn.disabled = true;
      try {
        if (action === 'delete') {
          if (!confirm('Delete this post permanently?')) {
            btn.disabled = false;
            return;
          }
          const res = await fetch('/api/posts?id=' + encodeURIComponent(id), {
            method: 'DELETE',
          });
          if (!res.ok) throw new Error('delete failed');
        } else if (action === 'toggle') {
          const nowPublished = row.getAttribute('data-published') === 'true';
          const res = await fetch('/api/posts', {
            method: 'PATCH',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ id, published: !nowPublished }),
          });
          if (!res.ok) throw new Error('toggle failed');
        }
        window.location.reload();
      } catch (e) {
        alert('Action failed. Please try again.');
        btn.disabled = false;
      }
    });
  });
</script>

<style>
  .dash {
    max-width: 60rem;
    padding-block: var(--space-lg) var(--space-2xl);
  }
  .dash__head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--space-md);
    flex-wrap: wrap;
    margin-bottom: var(--space-lg);
  }
  .dash__title {
    font-size: var(--text-2xl);
    font-weight: 800;
    letter-spacing: -0.02em;
  }
  .dash__sub {
    color: var(--color-muted);
    font-size: var(--text-sm);
    margin-top: 0.2rem;
  }
  .dash__head-actions {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
  }
  .dash__new {
    padding: 0.55rem 1rem;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--text-sm);
    color: var(--color-accent-ink);
    background: var(--color-accent);
    border-radius: var(--radius-sm);
    text-decoration: none;
  }
  .dash__logout {
    padding: 0.55rem 0.9rem;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: var(--text-sm);
    color: var(--color-ink-2);
    background: transparent;
    border: var(--rule-hair) solid var(--color-rule);
    border-radius: var(--radius-sm);
    cursor: pointer;
  }
  .dash__table-wrap {
    overflow-x: auto;
  }
  .dash__table {
    width: 100%;
    border-collapse: collapse;
    font-size: var(--text-sm);
  }
  .dash__table th {
    text-align: left;
    font-family: var(--font-display);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-size: var(--text-xs);
    color: var(--color-muted);
    padding: 0.5rem 0.75rem;
    border-bottom: var(--rule-hair) solid var(--color-rule);
  }
  .dash__table td {
    padding: 0.7rem 0.75rem;
    border-bottom: var(--rule-hair) solid var(--color-rule);
    vertical-align: middle;
  }
  .dash__cell-title {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }
  .dash__slug {
    color: var(--color-muted);
    font-size: var(--text-xs);
  }
  .dash__badge {
    display: inline-block;
    padding: 0.15rem 0.5rem;
    border-radius: 999px;
    font-size: var(--text-xs);
    font-weight: 700;
  }
  .dash__badge.is-live {
    background: color-mix(in oklch, var(--color-accent) 15%, transparent);
    color: var(--color-accent);
  }
  .dash__badge.is-draft {
    background: color-mix(in oklch, var(--color-muted) 18%, transparent);
    color: var(--color-ink-2);
  }
  .dash__actions {
    display: flex;
    gap: 0.75rem;
    white-space: nowrap;
  }
  .dash__link {
    background: none;
    border: none;
    padding: 0;
    font-size: var(--text-sm);
    color: var(--color-accent);
    cursor: pointer;
    text-decoration: none;
  }
  .dash__link:hover {
    text-decoration: underline;
  }
  .dash__link--danger {
    color: crimson;
  }
  .dash__empty {
    color: var(--color-muted);
  }
</style>
