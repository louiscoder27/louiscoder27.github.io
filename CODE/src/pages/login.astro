---
import BaseLayout from '../layouts/BaseLayout.astro';
import ThemeToggle from '../components/ThemeToggle.astro';

// Map fixed error codes to messages. Only known codes render a message; any
// unknown/attacker-supplied value falls back to a generic one, so nothing from
// the query string is ever reflected verbatim.
const ERROR_MESSAGES: Record<string, string> = {
  missing: 'Please enter both your email and password.',
  credentials: 'Incorrect email or password.',
  notadmin: 'That account is not authorised for admin access.',
  '1': 'Incorrect email or password.',
};
const errorCode = Astro.url.searchParams.get('error');
const errorMsg = errorCode
  ? ERROR_MESSAGES[errorCode] ?? 'Sign-in failed. Please try again.'
  : null;
---

<BaseLayout title="Sign in" themeToggle>
  <ThemeToggle />
  <section class="login page">
    <h1 class="login__title">Sign in</h1>
    <p class="login__lead">Enter your admin email and password to sign in.</p>

    {errorMsg && (
      <p class="login__note login__note--err">{errorMsg}</p>
    )}

    <form class="login__form" method="POST" action="/api/auth/login">
      <label class="login__label" for="email">Email</label>
      <input
        class="login__input"
        id="email"
        name="email"
        type="email"
        required
        autocomplete="email"
        placeholder="you@example.com"
      />
      <label class="login__label" for="password">Password</label>
      <input
        class="login__input"
        id="password"
        name="password"
        type="password"
        required
        autocomplete="current-password"
        placeholder="••••••••"
      />
      <button class="login__btn" type="submit">Sign in</button>
    </form>

    <p class="login__back"><a class="link" href="/">← Back to the blog</a></p>
  </section>
</BaseLayout>

<style>
  .login {
    max-width: 28rem;
    padding-block: var(--space-2xl);
  }
  .login__title {
    font-size: var(--text-2xl);
    font-weight: 800;
    letter-spacing: -0.02em;
  }
  .login__lead {
    margin-top: var(--space-sm);
    color: var(--color-ink-2);
  }
  .login__note {
    margin-top: var(--space-md);
    padding: var(--space-sm) var(--space-md);
    border-radius: var(--radius-sm);
    font-size: var(--text-sm);
  }
  .login__note--ok {
    background: color-mix(in oklch, var(--color-accent) 12%, transparent);
    color: var(--color-accent);
  }
  .login__note--err {
    background: color-mix(in oklch, crimson 12%, transparent);
    color: crimson;
  }
  .login__form {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
    margin-top: var(--space-lg);
  }
  .login__label {
    font-family: var(--font-display);
    font-size: var(--text-sm);
    font-weight: 600;
  }
  .login__input {
    padding: 0.7rem 0.9rem;
    font-size: var(--text-md);
    border: var(--rule-hair) solid var(--color-rule);
    border-radius: var(--radius-sm);
    background: var(--color-paper-2);
    color: var(--color-ink);
  }
  .login__input:focus {
    outline: 2px solid var(--color-accent);
    outline-offset: 1px;
  }
  .login__btn {
    margin-top: var(--space-xs);
    padding: 0.7rem 1rem;
    font-family: var(--font-display);
    font-weight: 700;
    color: var(--color-accent-ink);
    background: var(--color-accent);
    border: none;
    border-radius: var(--radius-sm);
    cursor: pointer;
  }
  .login__btn:hover {
    filter: brightness(1.05);
  }
  .login__back {
    margin-top: var(--space-lg);
    font-size: var(--text-sm);
  }
</style>
