---
import BaseLayout from '../layouts/BaseLayout.astro';
import IntroStage from '../components/IntroStage.astro';
import { SITE } from '../site.config';
import { CATEGORIES, CATEGORY_META, categorySlug } from '../lib/categories';
import { getPosts, countByCategory, yearsActive } from '../lib/posts';

const base = import.meta.env.BASE_URL;
const withBase = (p: string) => `${base}${p}`.replace(/\/{2,}/g, '/');

const posts = await getPosts();
const counts = countByCategory(posts);
const years = yearsActive(posts, SITE.sinceYear);

// Edge-cache the home page; background-revalidate so new posts appear quickly.
Astro.response.headers.set(
  'Cache-Control',
  'public, max-age=0, s-maxage=60, stale-while-revalidate=600',
);

// Shared shape for a post row in the work box.
const toWork = (p: (typeof posts)[number]) => ({
  title: p.data.title,
  description: p.data.description,
  date: p.data.pubDate.toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'short',
    day: 'numeric',
  }),
  category: p.data.category,
  // Posts live under their category: /courses/<slug>, /vault/<slug>, …
  href: withBase(`/${categorySlug(p.data.category)}/${p.id}`),
});

// The "Latest posts" default view + one view per category are all merged into
// IntroStage's third slide (the work box), so the data is prepared here.
const latest = posts.slice(0, 3).map(toWork);

// Each section becomes a tab inside the work box: clicking it swaps the box to
// show that category's title + posts in place. Reading a post still opens its
// own /<category>/<slug> page.
const sections = CATEGORIES.map((c) => ({
  name: c,
  slug: CATEGORY_META[c].slug,
  blurb: CATEGORY_META[c].blurb,
  count: counts[c] ?? 0,
  posts: posts.filter((p) => p.data.category === c).map(toWork),
}));
---

<BaseLayout hideFooter>
  <IntroStage
    postsCount={posts.length}
    projectsCount={counts['Projects'] ?? 0}
    years={years}
    latest={latest}
    sections={sections}
  />
</BaseLayout>
