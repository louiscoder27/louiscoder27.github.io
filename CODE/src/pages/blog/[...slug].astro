---
import PostLayout from '../../layouts/PostLayout.astro';
import { getPostBySlug } from '../../lib/posts';
import { highlightCodeBlocks } from '../../lib/highlight';

const { slug } = Astro.params;
const post = slug ? await getPostBySlug(slug) : null;

if (!post) {
  return new Response(null, { status: 404, statusText: 'Post not found' });
}

// The editor stores code blocks as plain text; colour their tokens here.
const bodyHtml = await highlightCodeBlocks(post.body_html);

// Cache the rendered page at the edge; revalidate in the background so a freshly
// published/edited post shows up quickly without hammering the database.
Astro.response.headers.set(
  'Cache-Control',
  'public, max-age=0, s-maxage=60, stale-while-revalidate=600',
);
---

<PostLayout
  title={post.data.title}
  description={post.data.description}
  pubDate={post.data.pubDate}
  updatedDate={post.data.updatedDate}
  category={post.data.category}
>
  <Fragment set:html={bodyHtml} />
</PostLayout>
