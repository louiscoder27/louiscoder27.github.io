---
import { getPostBySlug } from '../../lib/posts';
import { categorySlug } from '../../lib/categories';

// Posts moved from /blog/<slug> to a category-nested path (/courses/<slug>,
// /vault/<slug>, /projects/<slug>). Keep old /blog/<slug> links alive by
// redirecting them to the post's canonical category URL.
const base = import.meta.env.BASE_URL;
const withBase = (p: string) => `${base}${p}`.replace(/\/{2,}/g, '/');

const { slug } = Astro.params;
const post = slug ? await getPostBySlug(slug) : null;

if (!post) {
  return new Response(null, { status: 404, statusText: 'Post not found' });
}

// 302 (not 301): a post can be moved between categories later, and we don't want
// browsers to cache a stale category path.
return Astro.redirect(withBase(`/${categorySlug(post.data.category)}/${slug}`));
---
