---
// Table-of-contents for the reading page. On wide screens it renders as an
// "On this page" rail that sits in a reserved column to the right of the
// article (sticky, smaller type than the body, scroll-spy highlights the
// section you're reading). On narrow screens it collapses to a floating pill in
// the corner that opens the same list as a panel. Each entry smooth-scrolls to
// its heading and carries a copy button for a deep link (…/slug#heading-id) so a
// section can be referenced from another post. The list is built server-side
// from the post's headings (see src/lib/toc.ts).
import type { TocEntry } from '../lib/toc';

interface Props {
  toc: TocEntry[];
}
const { toc } = Astro.props;

// Indent each entry relative to the shallowest heading present, so a post that
// starts at h2 still reads flush-left.
const minLevel = toc.reduce((m, e) => Math.min(m, e.level), 6);
---

{
  toc.length > 0 && (
    <div class="toc" data-toc>
      <button
        class="toc__btn"
        type="button"
        aria-expanded="false"
        aria-controls="toc-panel"
        data-toc-btn
      >
        <svg
          class="toc__btn-icon"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M9 6h11M9 12h11M9 18h11" />
          <path d="M4.5 6h.01M4.5 12h.01M4.5 18h.01" />
        </svg>
        <span class="toc__btn-label">TOC</span>
      </button>

      <nav class="toc__panel" id="toc-panel" aria-label="Table of contents" hidden>
        <p class="toc__title">On this page</p>
        <ul class="toc__list">
          {toc.map((e) => (
            <li
              class="toc__item"
              data-depth={e.level - minLevel}
              style={`--depth:${e.level - minLevel}`}
            >
              <a class="toc__link" href={`#${e.id}`} data-toc-link>
                {e.text}
              </a>
              <button
                class="toc__copy"
                type="button"
                data-toc-copy={e.id}
                title="Copy link to this section"
                aria-label={`Copy link to “${e.text}”`}
              >
                <svg
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.7"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <path d="M10 13a5 5 0 0 0 7 0l2-2a5 5 0 0 0-7-7l-1 1" />
                  <path d="M14 11a5 5 0 0 0-7 0l-2 2a5 5 0 0 0 7 7l1-1" />
                </svg>
              </button>
            </li>
          ))}
        </ul>
      </nav>
    </div>
  )
}

<style>
  .toc {
    position: fixed;
    left: var(--space-md);
    bottom: var(--space-md);
    z-index: var(--z-overlay);
    font-family: var(--font-post);
  }

  /* ---- Trigger pill ---- */
  .toc__btn {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2xs);
    padding: 0.5rem 0.8rem;
    background: var(--color-paper-2);
    color: var(--color-ink);
    border: var(--rule-hair) solid var(--color-rule);
    border-radius: var(--radius-md);
    box-shadow: 0 6px 20px color-mix(in oklch, var(--shadow-color) 22%, transparent);
    cursor: pointer;
    transition:
      transform var(--dur-short) var(--ease-out),
      background var(--dur-short) var(--ease-out),
      border-color var(--dur-short) var(--ease-out);
  }
  .toc__btn:hover {
    transform: translateY(-1px);
    border-color: var(--color-accent);
  }
  .toc__btn:focus-visible {
    outline: 2px solid var(--color-focus);
    outline-offset: 2px;
  }
  .toc__btn-icon {
    width: 1.05rem;
    height: 1.05rem;
    flex: none;
  }
  .toc__btn-label {
    font-family: var(--font-post);
    font-size: 0.6rem;
    letter-spacing: 0.06em;
    line-height: 1;
  }

  /* ---- Panel ---- */
  .toc__panel {
    position: absolute;
    left: 0;
    bottom: calc(100% + var(--space-2xs));
    width: min(20rem, calc(100vw - 2 * var(--space-md)));
    max-height: min(60vh, 30rem);
    overflow-y: auto;
    padding: var(--space-sm);
    background: var(--color-paper-2);
    color: var(--color-ink);
    border: var(--rule-hair) solid var(--color-rule);
    border-radius: var(--radius-md);
    box-shadow: 0 10px 34px color-mix(in oklch, var(--shadow-color) 28%, transparent);
    /* Enter/exit animation */
    transform-origin: bottom left;
    animation: toc-in var(--dur-short) var(--ease-out);
  }
  .toc__panel[hidden] {
    display: none;
  }
  @keyframes toc-in {
    from {
      opacity: 0;
      transform: translateY(6px) scale(0.98);
    }
  }

  .toc__title {
    margin-bottom: var(--space-2xs);
    font-family: var(--font-post);
    font-size: 0.6rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-muted);
  }

  .toc__list {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .toc__item {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    padding-left: calc(var(--depth, 0) * 0.85rem);
  }
  .toc__link {
    flex: 1 1 auto;
    min-width: 0;
    display: block;
    padding: 0.3rem 0.35rem;
    border-radius: var(--radius-sm);
    font-size: var(--text-sm);
    line-height: 1.35;
    color: var(--color-ink-2);
    text-decoration: none;
    transition:
      color var(--dur-short) var(--ease-out),
      background var(--dur-short) var(--ease-out);
  }
  .toc__link:hover {
    color: var(--color-accent);
    background: var(--color-accent-tint);
  }
  .toc__item.is-current > .toc__link {
    color: var(--color-accent);
    font-weight: 700;
  }

  .toc__copy {
    flex: none;
    display: inline-grid;
    place-items: center;
    width: 1.75rem;
    height: 1.75rem;
    padding: 0;
    background: transparent;
    color: var(--color-muted);
    border: none;
    border-radius: var(--radius-sm);
    cursor: pointer;
    opacity: 0.55;
    transition:
      opacity var(--dur-short) var(--ease-out),
      color var(--dur-short) var(--ease-out),
      background var(--dur-short) var(--ease-out);
  }
  .toc__item:hover .toc__copy {
    opacity: 1;
  }
  .toc__copy:hover {
    color: var(--color-accent);
    background: var(--color-accent-tint);
  }
  .toc__copy:focus-visible {
    outline: 2px solid var(--color-focus);
    outline-offset: 1px;
    opacity: 1;
  }
  .toc__copy svg {
    width: 0.95rem;
    height: 0.95rem;
  }
  .toc__copy.is-copied {
    color: var(--color-accent);
    opacity: 1;
  }
  .toc__copy.is-copied svg {
    display: none;
  }
  .toc__copy.is-copied::after {
    content: '✓';
    font-size: 0.85rem;
    font-weight: 700;
  }

  @media (max-width: 640px) {
    .toc__btn-label {
      /* keep the pill compact on small screens but still show TOC */
      font-size: 0.55rem;
    }
  }

  /* ---- Wide screens: persistent "On this page" rail --------------------------
   * Above this breakpoint PostLayout gives the TOC its own grid column to the
   * right of the article, so the rail can sit in flow (sticky) instead of the
   * floating pill. The trigger button is dropped and the panel is always open. */
  @media (min-width: 64rem) {
    .toc {
      position: sticky;
      top: 4.75rem; /* clear the fixed theme toggle in the top-right corner */
      left: auto;
      bottom: auto;
      align-self: start;
      max-height: calc(100vh - 6rem);
      overflow-y: auto;
    }
    .toc__btn {
      display: none;
    }
    .toc__panel,
    .toc__panel[hidden] {
      /* Static, borderless rail — a hairline on the left divides it from the body. */
      display: block;
      position: static;
      width: auto;
      max-height: none;
      overflow: visible;
      padding: 0 0 0 var(--space-md);
      background: transparent;
      border: none;
      border-left: var(--rule-hair) solid var(--color-rule);
      border-radius: 0;
      box-shadow: none;
      animation: none;
    }
    .toc__title {
      margin-bottom: var(--space-sm);
    }
    .toc__item {
      /* Extra indent per level on top of the copy-button gap. */
      padding-left: calc(var(--depth, 0) * 0.75rem);
    }
    .toc__item + .toc__item {
      margin-top: 0.15rem;
    }
    /* Copy buttons stay out of the way until you hover an entry. */
    .toc__copy {
      opacity: 0;
    }
    /* Sub-headings read smaller and dimmer than the top-level entries. */
    .toc__item[data-depth='0'] > .toc__link {
      font-size: var(--text-sm);
    }
    .toc__item:not([data-depth='0']) > .toc__link {
      font-size: var(--text-xs);
      color: var(--color-muted);
    }
    /* Active section wins the accent colour over the dimmed sub-heading rule. */
    .toc__item.is-current > .toc__link {
      color: var(--color-accent);
    }
    /* Active section gets an accent bar flush with the rail's left rule. */
    .toc__item.is-current {
      position: relative;
    }
    .toc__item.is-current::before {
      content: '';
      position: absolute;
      left: calc(-1 * var(--space-md) - var(--rule-hair));
      top: 0.15rem;
      bottom: 0.15rem;
      width: 2px;
      background: var(--color-accent);
      border-radius: 2px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .toc__panel {
      animation: none;
    }
    .toc__btn {
      transition: none;
    }
  }
</style>

<script>
  // Wire up every TOC island on the page (there is only one, but scope defensively).
  document.querySelectorAll<HTMLElement>('[data-toc]').forEach((root) => {
    const btn = root.querySelector<HTMLButtonElement>('[data-toc-btn]');
    const panel = root.querySelector<HTMLElement>('#toc-panel');
    if (!btn || !panel) return;

    const open = () => {
      panel.hidden = false;
      btn.setAttribute('aria-expanded', 'true');
    };
    const close = () => {
      panel.hidden = true;
      btn.setAttribute('aria-expanded', 'false');
    };
    const toggle = () => (panel.hidden ? open() : close());

    btn.addEventListener('click', (e) => {
      e.stopPropagation();
      toggle();
    });

    // Clicking a heading link closes the panel (the browser handles the jump).
    panel.querySelectorAll<HTMLAnchorElement>('[data-toc-link]').forEach((link) => {
      link.addEventListener('click', () => close());
    });

    // Copy a deep link to the section. Uses the Clipboard API with a legacy
    // fallback so it works over http/localhost too.
    panel.querySelectorAll<HTMLButtonElement>('[data-toc-copy]').forEach((copyBtn) => {
      copyBtn.addEventListener('click', async (e) => {
        e.stopPropagation();
        const id = copyBtn.getAttribute('data-toc-copy');
        if (!id) return;
        const url = `${location.origin}${location.pathname}#${id}`;
        try {
          if (navigator.clipboard?.writeText) {
            await navigator.clipboard.writeText(url);
          } else {
            const ta = document.createElement('textarea');
            ta.value = url;
            ta.style.position = 'fixed';
            ta.style.opacity = '0';
            document.body.appendChild(ta);
            ta.select();
            document.execCommand('copy');
            ta.remove();
          }
          copyBtn.classList.add('is-copied');
          setTimeout(() => copyBtn.classList.remove('is-copied'), 1200);
        } catch {
          /* clipboard blocked — silently ignore */
        }
      });
    });

    // Close on outside click / Escape.
    document.addEventListener('click', (e) => {
      if (!panel.hidden && !root.contains(e.target as Node)) close();
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !panel.hidden) {
        close();
        btn.focus();
      }
    });

    // Scroll-spy: highlight the last heading you've scrolled past. We compute the
    // active heading directly from scroll position (deterministic) rather than
    // from IntersectionObserver "is it in a thin band" events, which left the
    // highlight stale between headings and raced on load — making it jump around.
    const links = Array.from(
      panel.querySelectorAll<HTMLAnchorElement>('[data-toc-link]'),
    );
    // Entries in document order, each paired with its heading and TOC item.
    const entries = links
      .map((link) => {
        const id = decodeURIComponent(link.hash.slice(1));
        const heading = id ? document.getElementById(id) : null;
        const item = link.closest('.toc__item') as HTMLElement | null;
        return heading && item ? { id, heading, item } : null;
      })
      .filter((e): e is { id: string; heading: HTMLElement; item: HTMLElement } => e !== null);

    if (entries.length) {
      // Line near the top of the viewport that counts as "you're reading here".
      // Matches the headings' scroll-margin-top so a clicked target reads active.
      const OFFSET = 100;
      let currentId: string | null = null;
      const setCurrent = (id: string) => {
        if (id === currentId) return;
        currentId = id;
        for (const e of entries) e.item.classList.toggle('is-current', e.id === id);
      };

      const update = () => {
        // Default to the first heading until one has scrolled past the line.
        let activeId = entries[0].id;
        for (const e of entries) {
          if (e.heading.getBoundingClientRect().top - OFFSET <= 0) activeId = e.id;
          else break;
        }
        // At the very bottom of the page, the last heading is what you're reading
        // even if it never reached the line (short final section).
        const atBottom =
          window.innerHeight + window.scrollY >=
          document.documentElement.scrollHeight - 2;
        if (atBottom) activeId = entries[entries.length - 1].id;
        setCurrent(activeId);
      };

      // Throttle to one update per frame while scrolling.
      let ticking = false;
      const onScroll = () => {
        if (ticking) return;
        ticking = true;
        requestAnimationFrame(() => {
          update();
          ticking = false;
        });
      };
      window.addEventListener('scroll', onScroll, { passive: true });
      window.addEventListener('resize', onScroll, { passive: true });
      update();
    }
  });
</script>
