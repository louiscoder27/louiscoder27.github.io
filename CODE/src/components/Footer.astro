---
// Ft2 · Inline-rule single line — brand + credit on the left, contact links on
// the right, split by a hairline. Background is transparent so the footer blends
// into whatever page ground it sits on (deep dark on reading/edit pages).
import { SITE } from '../site.config';
const year = new Date().getFullYear();
// GitHub is intentionally dropped from the footer (kept elsewhere, e.g. the
// home intro, which reads SITE.links directly).
const footerLinks = SITE.links.filter((l) => l.label.toLowerCase() !== 'github');
---

<footer class="foot">
  <div class="foot__wrap">
    <div class="page foot__col">
      <div class="foot__row">
        <p class="foot__brand">
          <span class="foot__mark">{SITE.title}</span>
          <span class="foot__sep" aria-hidden="true">·</span>
          <span class="foot__copy">© {year}</span>
        </p>
        <nav class="foot__links" aria-label="Contact">
          {
            footerLinks.map((l) => (
              <a class="foot__link" href={l.href}>{l.label}</a>
            ))
          }
        </nav>
      </div>
    </div>
  </div>
</footer>

<style>
  .foot {
    margin-top: 0;
    /* Blend into the page ground (paper) instead of the old dark band. */
    background-color: transparent;
  }
  /* Content column: same reading frame + page gutter as the article's `.page`
     wrapper, so the hairline below sits at the exact content edge. */
  .foot__col {
    max-width: var(--post-measure);
  }
  /* On post pages at the rail breakpoint the article is centred as an
     (article + TOC rail) pair, which squeezes the article column and pushes it
     left. Mirror that exact grid here so the footer's content column lines up
     with the article column — same length AND same horizontal position as the
     rule above the "Back to / Download" buttons. (Kept scoped to post pages;
     the home page footer stays simply centred.) */
  @media (min-width: 64rem) {
    :global(body.post-page) .foot__wrap {
      --toc-w: 13rem;
      display: grid;
      grid-template-columns: minmax(0, var(--post-measure)) var(--toc-w);
      justify-content: center;
      gap: var(--space-xl);
      max-width: calc(var(--post-measure) + var(--toc-w) + var(--space-xl));
      margin-inline: auto;
      padding-inline: var(--page-gutter);
    }
  }
  .foot__row {
    display: flex;
    flex-direction: column;
    gap: var(--space-2xs);
    /* The border is drawn on the content box (inside the page gutter), so it
       spans the same length as the rule above the "Back to / Download" buttons
       (`--post-measure` minus the gutter) rather than overshooting by two gutters. */
    padding-block: var(--space-md);
    border-top: var(--rule-hair) solid var(--color-rule);
    font-family: var(--font-post);
    font-size: var(--text-xs);
  }
  /* From tablet up: brand and links share one row (brand left, links right). */
  @media (min-width: 40rem) {
    .foot__row {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
      gap: var(--space-md);
    }
  }
  .foot__brand {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-2xs);
    color: var(--color-muted);
  }
  .foot__mark {
    font-weight: 700;
    letter-spacing: 0.02em;
    color: var(--color-accent);
  }
  .foot__sep {
    color: var(--color-rule);
  }
  .foot__copy {
    color: var(--color-muted);
  }
  .foot__links {
    display: inline-flex;
    flex-wrap: wrap;
    gap: var(--space-sm) var(--space-md);
  }
  .foot__link {
    color: var(--color-muted);
    white-space: nowrap;
    text-decoration: none;
    transition: color var(--dur-short) var(--ease-out);
  }
  .foot__link:hover {
    color: var(--color-accent);
  }
</style>
