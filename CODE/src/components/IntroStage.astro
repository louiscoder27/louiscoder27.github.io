---
// The Canva opener rebuilt as ONE pinned stage. A single fixed meadow sits
// behind a sticky viewport; scrolling crossfades between two layers *in place*
// on the same screen — the handwritten name dissolves out, the About cards
// dissolve in ("mờ và rõ dần") — before the page continues to the blog content.
import { SITE } from '../site.config';

interface WorkPost {
  title: string;
  description: string;
  date: string;
  category: string;
  href: string;
}
interface WorkSection {
  name: string;
  slug: string;
  blurb: string;
  count: number;
  posts: WorkPost[];
}
interface Props {
  postsCount: number;
  projectsCount: number;
  years: number;
  latest: WorkPost[];
  sections: WorkSection[];
}
// Stats + list data are passed in from the page so they stay derived from real content.
const { postsCount, projectsCount, years, latest, sections } = Astro.props;

// Footer content moved up under the quote (the old dark footer bar is dropped
// on the home page). Same links/credit as Footer.astro.
const year = new Date().getFullYear();

const base = import.meta.env.BASE_URL;
const withBase = (p: string) => `${base}${p}`.replace(/\/{2,}/g, '/');

// Uppercase-first, as written by the author: "Louis".
const wordmark = 'Louis';

// About content.
const heading = 'Trinh Dat // Louis';
const affiliation = 'Investments Economics';
const bio = 'Investments student from UEH. Focus on finance, mathematics, econometrics.';
const fields = ['Finance', 'Mathematics', 'Econometrics'];

// Persistent top-left nav. Collapsed to a single "categories" grid icon; on
// hover it expands into a tall vertical strip down the left edge listing every
// destination. Home + About are scroll anchors; each category is a tab that
// swaps the work box in place. `key` doubles as the hash and the data-tab.
const menuIcon =
  '<svg viewBox="0 0 24 24" fill="currentColor" xmlns="http://www.w3.org/2000/svg"><path d="m10.357 13.262c-.049-.011-1.205-.262-2.357-.262s-2.309.251-2.357.262c-.19.042-.339.19-.381.381-.011.049-.262 1.205-.262 2.357s.251 2.309.262 2.357c.042.19.19.339.381.381.049.011 1.205.262 2.357.262s2.309-.251 2.357-.262c.19-.042.339-.19.381-.381.011-.049.262-1.205.262-2.357s-.251-2.309-.262-2.357c-.042-.19-.19-.339-.381-.381zm-.534 4.561c-.402.07-1.124.177-1.823.177s-1.421-.106-1.823-.177c-.07-.402-.177-1.124-.177-1.823s.106-1.421.177-1.823c.402-.07 1.124-.177 1.823-.177s1.421.106 1.823.177c.07.402.177 1.124.177 1.823s-.106 1.421-.177 1.823zm.534-12.561c-.049-.011-1.205-.262-2.357-.262s-2.309.251-2.357.262c-.19.042-.339.19-.381.381-.011.049-.262 1.205-.262 2.357s.251 2.309.262 2.357c.042.19.19.339.381.381.049.011 1.205.262 2.357.262s2.309-.251 2.357-.262c.19-.042.339-.19.381-.381.011-.049.262-1.205.262-2.357s-.251-2.309-.262-2.357c-.042-.19-.19-.339-.381-.381zm-.534 4.561c-.402.071-1.124.177-1.823.177s-1.421-.106-1.823-.177c-.07-.402-.177-1.124-.177-1.823s.106-1.421.177-1.823c.402-.071 1.124-.177 1.823-.177s1.421.106 1.823.177c.07.402.177 1.124.177 1.823s-.106 1.421-.177 1.823zm12.115-7.38c-.042-.191-.19-.34-.381-.381-.049-.011-4.891-1.062-9.558-1.062s-9.508 1.051-9.557 1.062c-.19.042-.339.19-.381.381-.011.048-1.062 4.891-1.062 9.557s1.051 9.509 1.062 9.558c.042.19.19.339.381.381.049.011 4.891 1.062 9.558 1.062s9.509-1.051 9.558-1.062c.19-.042.339-.19.381-.381.011-.049 1.062-4.891 1.062-9.558s-1.051-9.509-1.062-9.557zm-.911 18.584c-1.137.228-5.148.973-9.027.973s-7.891-.745-9.027-.973c-.228-1.137-.973-5.148-.973-9.027s.745-7.891.973-9.027c1.137-.228 5.148-.973 9.027-.973s7.891.745 9.027.973c.228 1.136.973 5.148.973 9.027s-.745 7.891-.973 9.027zm-2.67-15.765c-.049-.011-1.205-.262-2.357-.262s-2.309.251-2.357.262c-.19.042-.339.19-.381.381-.011.049-.262 1.205-.262 2.357s.251 2.309.262 2.357c.042.19.19.339.381.381.049.011 1.205.262 2.357.262s2.309-.251 2.357-.262c.19-.042.339-.19.381-.381.011-.049.262-1.205.262-2.357s-.251-2.309-.262-2.357c-.042-.19-.19-.339-.381-.381zm-.534 4.561c-.402.071-1.124.177-1.823.177s-1.421-.106-1.823-.177c-.07-.402-.177-1.124-.177-1.823s.106-1.421.177-1.823c.402-.071 1.124-.177 1.823-.177s1.421.106 1.823.177c.07.402.177 1.124.177 1.823s-.106 1.421-.177 1.823zm.534 3.439c-.049-.011-1.205-.262-2.357-.262s-2.309.251-2.357.262c-.19.042-.339.19-.381.381-.011.049-.262 1.205-.262 2.357s.251 2.309.262 2.357c.042.19.19.339.381.381.049.011 1.205.262 2.357.262s2.309-.251 2.357-.262c.19-.042.339-.19.381-.381.011-.049.262-1.205.262-2.357s-.251-2.309-.262-2.357c-.042-.19-.19-.339-.381-.381zm-.534 4.561c-.402.07-1.124.177-1.823.177s-1.421-.106-1.823-.177c-.07-.402-.177-1.124-.177-1.823s.106-1.421.177-1.823c.402-.07 1.124-.177 1.823-.177s1.421.106 1.823.177c.07.402.177 1.124.177 1.823s-.106 1.421-.177 1.823z"/></svg>';
const navIcons: Record<string, string> = {
  home: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M4 11 12 4l8 7"/><path d="M6 10v9h12v-9"/></svg>',
  about:
    '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="4"/><path d="M4 20c0-4 3.6-6 8-6s8 2 8 6"/></svg>',
  vault:
    '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="16" rx="2"/><circle cx="12" cy="12" r="4"/><path d="M12 12v-2M12 12l1.6 1.2"/><path d="M12 4v2M12 20v-2"/></svg>',
  courses:
    '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M4 5h7v15H6a2 2 0 0 1-2-2z"/><path d="M20 5h-7v15h5a2 2 0 0 0 2-2z"/></svg>',
  projects:
    '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M4 7a2 2 0 0 1 2-2h3l2 2h7a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2z"/></svg>',
};
const navItems = [
  { label: 'Home', href: '#home', key: 'home' },
  { label: 'About', href: '#about', key: 'about' },
  ...sections.map((s) => ({ label: s.name, href: `#${s.slug}`, key: s.slug })),
];
---

<section id="home" class="intro" aria-label="Introduction">
  <noscript>
    <style>
      /* Without JS there's no scroll crossfade — stack the two slides. */
      .intro { height: auto !important; }
      .intro__sticky { position: static !important; height: auto !important; }
      .intro__layer { position: static !important; opacity: 1 !important; filter: none !important; transform: none !important; min-height: 100svh; }
    </style>
  </noscript>

  <div class="intro__sticky">
    <!-- Looping video backdrop — muted/inline so it autoplays everywhere; the
         still background.jpg is the poster so there's never a blank frame while
         the video loads (and it shows if the browser blocks autoplay). -->
    <video
      class="intro__video"
      autoplay
      muted
      loop
      playsinline
      preload="auto"
      poster={withBase('/background.jpg')}
      aria-hidden="true"
    >
      <source src={withBase('/background.mp4')} type="video/mp4" />
    </video>
    <div class="intro__grade" aria-hidden="true"></div>

    <!-- Persistent top-left nav — collapsed to a single grid icon, expands on
         hover into a tall vertical strip. Present across all three slides;
         replaces the old bottom nav and the work-box rail. Category items carry
         data-tab to swap the box. The script flips it to open upward when
         opening downward would overrun the viewport bottom. -->
    <nav class="topnav" aria-label="Primary" data-topnav>
      <span class="topnav__toggle" aria-hidden="true">
        <span class="topnav__ic topnav__ic--menu" set:html={menuIcon} />
      </span>
      <ul class="topnav__list">
        {
          navItems.map((it) => (
            <li>
              <a class="topnav__item" href={it.href} data-tab={it.key}>
                <span class="topnav__ic" set:html={navIcons[it.key]} />
                <span class="topnav__label">{it.label}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <!-- Layer 1 — the name, revealed by a slow decoding scramble that cycles
         between "Louis" and "Hello" forever. JS drives the per-character spans;
         the static label keeps it accessible / correct without JS. -->
    <div class="intro__layer intro__layer--name">
      <h1 class="intro__mark">
        <span class="intro__ink" data-scramble aria-hidden="true">{wordmark}</span>
        <span class="sr-only">{wordmark}</span>
      </h1>
    </div>

    <!-- Layer 2 — the About cards -->
    <div class="intro__layer intro__layer--about" aria-labelledby="about-heading">
      <h2 id="about-heading" class="sr-only">About</h2>
      <div class="about__grid">
        <!-- Left — identity, quick links, live stats -->
        <article class="glass about__id">
          <div class="about__id-top">
            <p class="about__name">{heading}</p>
            <p class="about__affil">{affiliation}</p>
            <div class="about__links">
              <a class="about__pill" href="#work">Latest posts</a>
              <a class="about__pill" href="#work">Sections</a>
            </div>
          </div>
          <div class="about__stats">
            <div class="about__stat">
              <span class="about__num tnum">{postsCount}</span>
              <span class="about__lbl">Posts</span>
            </div>
            <div class="about__stat">
              <span class="about__num tnum">{projectsCount}</span>
              <span class="about__lbl">Projects</span>
            </div>
            <div class="about__stat">
              <span class="about__num tnum">{years}<span class="about__unit">yr</span></span>
              <span class="about__lbl">Active</span>
            </div>
          </div>
        </article>

        <!-- Right — bio + fields of study -->
        <div class="about__side">
          <article class="glass about__bio">
            <p>{bio}</p>
          </article>
          <ul class="about__fields">
            {fields.map((f) => <li class="glass about__field">{f}</li>)}
          </ul>
        </div>
      </div>
    </div>

    <!-- Layer 3 — merged "Latest posts" + "Sections" panel -->
    <div class="intro__layer intro__layer--work" aria-labelledby="work-heading">
      <h2 id="work-heading" class="sr-only">Latest posts and sections</h2>
      <div class="work glass">
        <!-- One swappable view per tab. Home = latest posts; each section shows
             its own title + posts. Only the active view is displayed. -->
        <div class="work__body">
          <div class="work__view is-active" data-view="home">
            <div class="work__head">
              <h3 class="work__title">Latest posts</h3>
            </div>
            <ul class="work__posts">
              {
                latest.map((p) => (
                  <li>
                    <a class="wpost" href={p.href}>
                      <div class="wpost__main">
                        <p class="wpost__title">{p.title}</p>
                        <p class="wpost__desc">{p.description}</p>
                        <p class="wpost__date">{p.date}</p>
                      </div>
                      <span class="wpost__cat">{p.category}</span>
                    </a>
                  </li>
                ))
              }
            </ul>
          </div>

          {
            sections.map((s) => (
              <div class="work__view" data-view={s.slug} aria-label={s.name}>
                <div class="work__head">
                  <h3 class="work__title">{s.name}</h3>
                  <span class="work__count">
                    {s.count} {s.count === 1 ? 'essay' : 'essays'}
                  </span>
                </div>
                {s.posts.length > 0 ? (
                  <ul class="work__posts">
                    {s.posts.map((p) => (
                      <li>
                        <a class="wpost" href={p.href}>
                          <div class="wpost__main">
                            <p class="wpost__title">{p.title}</p>
                            <p class="wpost__desc">{p.description}</p>
                            <p class="wpost__date">{p.date}</p>
                          </div>
                          <span class="wpost__cat">{p.category}</span>
                        </a>
                      </li>
                    ))}
                  </ul>
                ) : (
                  <p class="work__empty">
                    Nothing here yet — the first essay in this section is on its way.
                  </p>
                )}
              </div>
            ))
          }
        </div>
      </div>
    </div>

    <!-- Persistent footer quote (nav moved to the fixed top-left rail). The old
         dark footer bar's content now sits right under the quote, in white. -->
    <div class="intro__bar">
      {
        SITE.hero.quotes.length > 0 && (
          <div class="intro__quotes">
            {SITE.hero.quotes.map((q) => (
              <p class="intro__quote">{q}</p>
            ))}
          </div>
        )
      }
      <p class="intro__foot">
        <span class="intro__foot-mark">{SITE.title}</span>
        {
          SITE.links.map((l) => (
            <>
              <span class="intro__foot-sep" aria-hidden="true">·</span>
              <a class="intro__foot-link" href={l.href}>{l.label}</a>
            </>
          ))
        }
        <span class="intro__foot-sep" aria-hidden="true">·</span>
        <span class="intro__foot-copy">© {year}</span>
      </p>
    </div>
  </div>

</section>

<style is:global>
  @property --write {
    syntax: '<number>';
    inherits: true;
    initial-value: 100;
  }
</style>

<style define:vars={{ meadow: `url('${withBase('/background.jpg')}')` }}>
  /* One fixed screen; the nav crossfades the layers in place (no page change). */
  .intro {
    position: relative;
    /* One fixed screen — no scroll travel. The nav (not scrolling) crossfades
       between the wordmark, About and the work box. */
    height: 100svh;
    background: var(--color-ink);
  }

  .intro__sticky {
    position: relative;
    top: 0;
    height: 100svh;
    overflow: clip;
    isolation: isolate;
    /* Fixed painterly meadow — locked to the viewport (Canva slide feel). */
    background-image: var(--meadow);
    background-size: cover;
    background-position: 50% 50%;
    background-attachment: fixed;
    color: var(--hero-ink);
  }

  /* Looping video backdrop — covers the sticky viewport, sits at the very back
     (below the vignette at z-index 0 and all content at z-index 1). The still
     background.jpg on .intro__sticky shows through if the video ever fails. */
  .intro__video {
    position: absolute;
    inset: 0;
    z-index: -1;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 50%;
    pointer-events: none;
  }

  .intro__grade {
    position: absolute;
    inset: 0;
    z-index: 0;
    background:
      radial-gradient(120% 90% at 50% 42%, transparent 58%, var(--hero-wash) 100%),
      linear-gradient(to bottom, transparent 58%, var(--hero-scrim) 100%);
    pointer-events: none;
  }

  /* All three layers occupy the same centred box; the nav crossfades one into
     the next in place (opacity/blur/scale animate via these transitions). Only
     the active layer is interactive. In the no-JS/static fallback they stack. */
  .intro__layer {
    position: absolute;
    inset: 0;
    z-index: 1;
    display: grid;
    place-items: center;
    padding: clamp(3rem, 8vh, 6rem) var(--page-gutter) clamp(6rem, 14vh, 9rem);
    pointer-events: none;
    transition:
      opacity 520ms var(--ease-in-out),
      filter 520ms var(--ease-in-out),
      transform 520ms var(--ease-in-out);
  }
  .intro__layer.is-active {
    pointer-events: auto;
  }
  .intro__layer--name {
    opacity: var(--name-op, 1);
  }
  .intro__layer--about {
    opacity: var(--about-op, 0);
    filter: blur(calc((1 - var(--about-op, 0)) * 16px));
    transform: scale(calc(0.97 + var(--about-op, 0) * 0.03));
  }
  .intro__layer--work {
    opacity: var(--work-op, 0);
    filter: blur(calc((1 - var(--work-op, 0)) * 16px));
    transform: scale(calc(0.97 + var(--work-op, 0) * 0.03));
  }

  /* ---- The scrambling wordmark (Crude font) ---- */
  .intro__mark {
    margin: 0;
    line-height: 1.15;
    text-align: center;
  }
  .intro__ink {
    position: relative;
    display: inline-flex;
    justify-content: center;
    align-items: baseline;
    font-family: var(--font-crude);
    font-weight: 400;
    /* ▼▼ ĐỔI KÍCH THƯỚC CHỮ "LOUIS/HELLO" TẠI ĐÂY ▼▼
       clamp(nhỏ-nhất-trên-mobile, co-giãn-theo-màn-hình, lớn-nhất-trên-desktop)
       Muốn chữ nhỏ lại: giảm cả 3 số, ví dụ clamp(3rem, 12vw, 9rem). */
    font-size: clamp(2.5rem, 10vw, 7rem);
    /* ▲▲ ---------------------------------------- ▲▲ */
    line-height: 1.3;
    padding: 0.14em 0.16em 0.24em;
    letter-spacing: 0.02em;
    color: var(--hero-ink);
    text-shadow: 0 2px 26px color-mix(in oklch, var(--shadow-color) 55%, transparent);
  }
  /* Each character is its own cell so scramble glyphs of different widths don't
     shove the line around — a fixed min-width keeps positions calm and steady. */
  .intro__char {
    display: inline-block;
    min-width: 0.62em;
    text-align: center;
    /* When a settled char is un-flashed, it eases from the accent back to snow,
       giving the "lock" a soft glow that fades rather than a hard blink. */
    transition:
      color 620ms var(--ease-out),
      text-shadow 620ms var(--ease-out);
  }
  /* Mid-scramble glyphs sit slightly dimmer so the locked letters read first. */
  .intro__char--scramble {
    color: color-mix(in oklch, var(--hero-ink) 62%, transparent);
  }
  /* The instant a character locks into place — a gentle warm-gold accent glow. */
  .intro__char--lock {
    color: var(--color-light-gold);
    text-shadow:
      0 0 18px color-mix(in oklch, var(--color-light-gold) 70%, transparent),
      0 2px 26px color-mix(in oklch, var(--shadow-color) 55%, transparent);
  }

  /* ---- About cards ---- */
  .about__grid {
    width: 100%;
    max-width: var(--content-max);
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: clamp(1.25rem, 3vw, 2rem);
    align-items: stretch;
  }
  .glass {
    margin: 0;
    background: color-mix(in srgb, var(--color-glass) calc(var(--glass-alpha) * 100%), transparent);
    -webkit-backdrop-filter: blur(6px);
    backdrop-filter: blur(6px);
    border: 1px solid color-mix(in oklch, var(--sheen-color) 35%, transparent);
    border-radius: var(--radius-lg);
    /* Deeper, layered shadow so the cards lift off the meadow. */
    box-shadow:
      0 34px 80px color-mix(in oklch, var(--shadow-color) 42%, transparent),
      0 12px 28px color-mix(in oklch, var(--shadow-color) 26%, transparent);
  }
  /* ---- Left: identity card (name, quick links, stats) ---- */
  .about__id {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: clamp(1.5rem, 5vh, 3rem);
    padding: clamp(1.75rem, 4vw, 3.25rem);
  }
  .about__name {
    margin: 0;
    font-family: var(--font-body);
    font-weight: 700;
    font-size: clamp(1.85rem, 4.4vw, 3rem);
    line-height: 1.03;
    letter-spacing: 0.01em;
    color: var(--color-ink);
  }
  .about__affil {
    margin: var(--space-2xs) 0 0;
    font-family: var(--font-body);
    font-weight: 400;
    font-size: clamp(1rem, 2.2vw, 1.375rem);
    letter-spacing: 0.12em;
    color: var(--color-ink-2);
  }
  .about__links {
    margin-top: clamp(1rem, 3vh, 1.75rem);
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2xs);
  }
  .about__pill {
    font-family: var(--font-body);
    font-size: var(--text-sm);
    font-weight: 600;
    letter-spacing: 0.08em;
    color: var(--color-ink);
    padding: 0.6rem 1.15rem;
    border-radius: 999px;
    background: color-mix(in srgb, var(--color-glass) 82%, transparent);
    border: 1px solid color-mix(in oklch, var(--sheen-color) 40%, transparent);
    box-shadow: 0 6px 16px color-mix(in oklch, var(--shadow-color) 18%, transparent);
    transition: transform var(--dur-short) var(--ease-out),
      background-color var(--dur-short) var(--ease-out);
  }
  .about__pill:hover {
    transform: translateY(-2px);
    background: color-mix(in srgb, var(--color-glass) 95%, transparent);
  }

  /* Stats row (numbers stay derived from real content) */
  .about__stats {
    display: flex;
    flex-wrap: wrap;
    gap: clamp(1rem, 4vw, 2.5rem);
    font-family: var(--font-body);
  }
  .about__stat {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }
  .about__num {
    font-weight: 700;
    font-size: clamp(2.1rem, 4.6vw, 3.1rem);
    line-height: 1;
    color: var(--color-ink);
  }
  .about__unit {
    font-size: 0.5em;
    margin-left: 0.06em;
  }
  .about__lbl {
    margin-top: var(--space-3xs);
    font-size: var(--text-sm);
    font-weight: 700;
    letter-spacing: 0.14em;
    color: var(--color-ink);
  }

  /* ---- Right: bio card + fields of study ---- */
  .about__side {
    display: flex;
    flex-direction: column;
    gap: clamp(0.9rem, 2vw, 1.5rem);
  }
  .about__bio {
    padding: clamp(1.5rem, 3.5vw, 2.25rem);
    display: grid;
    place-items: center;
    text-align: center;
  }
  .about__bio p {
    margin: 0;
    font-family: var(--font-body);
    font-weight: 700;
    font-size: clamp(0.95rem, 1.7vw, 1.25rem);
