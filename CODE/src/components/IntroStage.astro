    letter-spacing: 0.01em;
    text-shadow: 0 1px 18px color-mix(in oklch, var(--shadow-color) 60%, transparent);
  }
  /* Footer content relocated under the quote — same font as the old footer bar
     (--font-display), rendered in white. */
