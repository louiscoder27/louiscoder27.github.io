    transition: border-color var(--dur-short) var(--ease-out);
  }
  .intro__foot-link:hover {
    border-bottom-color: #fff;
  }
  /* When the quote box would collide with the centred info/work box, a small
     script measures the overlap and adds this class — drop the whole footer
     (quote AND nav) so nothing overlaps. */
  .intro__bar.is-collapsed {
