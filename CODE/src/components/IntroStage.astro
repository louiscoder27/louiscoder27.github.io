<script>
  // ---- Decoding-scramble wordmark ----
  // A calm, slow "decode" reveal that cycles between two words forever:
  // scrambled glyphs settle — out of order, one cell at a time — into "Louis",
  // hold, then re-scramble and settle into "Hello", and repeat. Tuned for a
  // relaxed feel: unhurried glyph flips (~10/sec), a soft accent glow as each
  // cell locks, no strobing.
  const scrambleEl = document.querySelector<HTMLElement>('.intro__ink[data-scramble]');
  if (scrambleEl) {
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const WORDS = ['Louis', 'Hello'];

    if (reduce) {
      // Respect reduced-motion: no scramble, just the first word, held.
      scrambleEl.textContent = WORDS[0];
    } else {
      // Pre-decode "noise" glyphs. Restricted to characters that actually exist
      // in the Crude font so every frame renders in the same face (no fallback
      // glyphs sneaking in). Crude's set: A–Z a–z 0–9 ! # $ % ( ) + , - . : ; = ? @ [ ] _ { }
      const GLYPHS = [
        ...'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789!#$%()+,-.:;=?@[]_{}',
      ];
      const rand = <T,>(a: T[]): T => a[(Math.random() * a.length) | 0];

      const DWELL = 2600; // ms to hold a fully-decoded word before re-scrambling
      const SETTLE_MIN = 1000; // ms — earliest a cell locks in
      const SETTLE_SPREAD = 1500; // ms — extra random window so cells lock out of order
      const FLIP_MIN = 70; // ms between glyph flips (slow, non-strobing)
      const FLIP_SPREAD = 90;
      const FRESH = 520; // ms the warm "just locked" accent stays before fading

      interface Slot {
        span: HTMLSpanElement;
        to: string;
        end: number; // timestamp this cell locks
        nextFlip: number;
        locked: boolean;
        freshUntil: number;
      }

      let slots: Slot[] = [];
      let prev = '';
      let phase: 'decode' | 'hold' = 'decode';
      let holdUntil = 0;
      let wordIndex = 0;

      const build = (target: string) => {
        const now = performance.now();
        const len = Math.max(target.length, prev.length, 1);
        scrambleEl.textContent = '';
        slots = [];
        for (let i = 0; i < len; i++) {
          const span = document.createElement('span');
          span.className = 'intro__char intro__char--scramble';
          span.textContent = rand(GLYPHS);
          scrambleEl.appendChild(span);
          slots.push({
            span,
            to: target[i] ?? '',
            end: now + SETTLE_MIN + Math.random() * SETTLE_SPREAD,
            nextFlip: now,
            locked: false,
            freshUntil: 0,
          });
        }
      };

      const frame = (now: number) => {
        if (phase === 'decode') {
          let allLocked = true;
          for (const s of slots) {
            if (s.locked) {
              if (s.freshUntil && now >= s.freshUntil) {
                s.span.classList.remove('intro__char--lock');
                s.freshUntil = 0;
              }
              continue;
            }
            if (now >= s.end) {
              // Lock this cell into its final letter with a soft accent flash.
              s.locked = true;
              if (s.to === '') {
                s.span.remove();
              } else {
                s.span.textContent = s.to;
                s.span.classList.remove('intro__char--scramble');
                s.span.classList.add('intro__char--lock');
                s.freshUntil = now + FRESH;
              }
            } else {
              allLocked = false;
              if (now >= s.nextFlip) {
                s.span.textContent = rand(GLYPHS);
                s.nextFlip = now + FLIP_MIN + Math.random() * FLIP_SPREAD;
              }
            }
          }
          if (allLocked) {
            prev = WORDS[wordIndex];
            phase = 'hold';
            holdUntil = now + DWELL;
          }
        } else {
          // Holding the decoded word — just let any lingering lock-glow fade out.
          for (const s of slots) {
            if (s.freshUntil && now >= s.freshUntil) {
              s.span.classList.remove('intro__char--lock');
              s.freshUntil = 0;
            }
          }
          if (now >= holdUntil) {
            wordIndex = (wordIndex + 1) % WORDS.length;
            build(WORDS[wordIndex]);
            phase = 'decode';
          }
        }
        requestAnimationFrame(frame);
      };

      build(WORDS[0]);
      requestAnimationFrame(frame);
    }
  }

  // Drive a three-stage in-place crossfade from scroll position:
  // name → about → work, each dissolving into the next over the fixed meadow.
  // The slides no longer respond to scroll — the top-left nav is the only
  // control. These refs are the three layers the nav crossfades between.
  const section = document.querySelector<HTMLElement>('.intro');
  const nameLayer = document.querySelector<HTMLElement>('.intro__layer--name');
  const about = document.querySelector<HTMLElement>('.intro__layer--about');
  const work = document.querySelector<HTMLElement>('.intro__layer--work');

  // ---- Tabbed content inside the work box ----
  // The rail, the bottom nav, and deep-links from post pages all set the URL
  // hash (#vault …); this swaps which view shows in the box, in place. Only
  // "Home" points at a real element (#home), so category hashes never trigger a
  // native scroll — we control the reveal ourselves.
  const body = document.querySelector<HTMLElement>('.work__body');
  const views = body ? Array.from(body.querySelectorAll<HTMLElement>('.work__view')) : [];
  const tabLinks = Array.from(document.querySelectorAll<HTMLElement>('[data-tab]'));

  // After a mouse click, a rail link keeps :focus, which holds the rail open
  // (via :focus-within) until you click elsewhere. Drop focus so the rail
  // collapses as soon as the pointer leaves it.
  document.querySelectorAll<HTMLElement>('.topnav a').forEach((link) => {
    link.addEventListener('click', () => {
      requestAnimationFrame(() => link.blur());
    });
  });

  // ---- Top-left nav: open upward when opening down would overrun the screen ----
  // Collapsed, the nav is a single icon at the top-left. Expanded, it grows into
  // a tall strip. If, from its current top, the fully-open strip would extend
  // past the bottom of the viewport (i.e. collide with content / run off-screen),
  // pin it to open *upward* instead: the grid icon keeps its place while the
  // items stack above it.
  const topnav = document.querySelector<HTMLElement>('[data-topnav]');
  if (topnav) {
    const MARGIN = 16; // px of breathing room to keep at the viewport edge
    const list = topnav.querySelector<HTMLElement>('.topnav__list');
    let open = false;
    let openH = 0;

    // The strip's fully-open height, computed *without* forcing the element open
    // — so it never disables (and thus never clobbers) the hover-open transition,
    // and never flashes on load. A clipped list still reports its full content
    // height via scrollHeight.
    const measure = () => {
      const cs = getComputedStyle(topnav);
      const padY = parseFloat(cs.paddingTop) + parseFloat(cs.paddingBottom);
      const borderY = parseFloat(cs.borderTopWidth) + parseFloat(cs.borderBottomWidth);
      const rootFont = parseFloat(getComputedStyle(document.documentElement).fontSize) || 16;
      const gap = 0.4 * rootFont; // the container's open gap between toggle + list
      const toggle = topnav.querySelector<HTMLElement>('.topnav__toggle')?.offsetHeight ?? 40;
      openH = padY + borderY + toggle + gap + (list?.scrollHeight ?? 0);
    };

    // Resting state: collapsed, top-anchored (grid icon top-left).
    const reset = () => {
      topnav.classList.remove('is-up');
      topnav.style.bottom = '';
    };

    // If opening downward from the icon would run past the bottom of the
    // viewport, flip to open upward — the strip pins to the bottom edge and, via
    // column-reverse, the grid icon sits at the bottom while items grow above it.
    const orient = () => {
      reset();
      const top = topnav.getBoundingClientRect().top;
      if (top + openH + MARGIN > window.innerHeight) {
        topnav.style.bottom = `${MARGIN}px`;
        topnav.classList.add('is-up');
      }
    };

    // Only reorient/flip while it's actually open (hover or keyboard focus); at
    // rest it always shows the collapsed icon at the top-left.
    topnav.addEventListener('pointerenter', () => { open = true; orient(); });
    topnav.addEventListener('pointerleave', () => { open = false; reset(); });
    topnav.addEventListener('focusin', () => { open = true; orient(); });
    topnav.addEventListener('focusout', (e) => {
      if (!topnav.contains(e.relatedTarget as Node)) { open = false; reset(); }
    });
    window.addEventListener('resize', () => { measure(); if (open) orient(); }, { passive: true });

    measure();
  }

  if (section && views.length) {
    const hasView = (key: string) => views.some((v) => v.dataset.view === key);

    const setView = (key: string) => {
      const active = hasView(key) ? key : 'home';
      views.forEach((v) => v.classList.toggle('is-active', v.dataset.view === active));
    };

    // Map the URL hash → which layer is shown (and, for the work box, which tab):
    //   #home / (empty) → wordmark hero    #about → About cards
    //   #work           → work box, Latest  #vault/#courses/#projects → that tab
    const applyState = () => {
      const key = (location.hash || '').replace('#', '');
      let layer: 'name' | 'about' | 'work';
      if (key === 'about') {
        layer = 'about';
      } else if (key === 'work') {
        layer = 'work';
        setView('home');
      } else if (key && key !== 'home' && hasView(key)) {
        layer = 'work';
        setView(key);
      } else {
        layer = 'name';
        setView('home');
      }

      section.style.setProperty('--name-op', layer === 'name' ? '1' : '0');
      section.style.setProperty('--about-op', layer === 'about' ? '1' : '0');
      section.style.setProperty('--work-op', layer === 'work' ? '1' : '0');

      nameLayer?.classList.toggle('is-active', layer === 'name');
      about?.classList.toggle('is-active', layer === 'about');
      work?.classList.toggle('is-active', layer === 'work');

      // Highlight the active nav item. Home is the resting default, so it never
      // gets the active pill.
      tabLinks.forEach((a) =>
        a.toggleAttribute('data-current', !!key && key !== 'home' && a.dataset.tab === key),
      );
    };

    window.addEventListener('hashchange', applyState);
    // Honour a deep-linked slide on first load (e.g. /#vault from a post).
    applyState();
  }

  // ---- Hide the footer when the quote collides with the content box ----
  // The About card and the work box are centred in the sticky stage; the quote
  // + nav bar sits at the bottom. On small / short screens the box grows tall
  // enough to overlap the bar. Measure the real geometry (not a guessed
  // breakpoint) and drop the whole bar when the lowest box edge reaches it.
  const bar = document.querySelector<HTMLElement>('.intro__bar');
  const boxes = Array.from(
    document.querySelectorAll<HTMLElement>('.about__grid, .work'),
  );
  if (bar && boxes.length) {
    const GAP = 12; // px of breathing room required between box and bar

    const syncBar = () => {
      // Remove first so the bar is measurable even if it's currently hidden;
      // reading offsetTop below forces the reflow so measurements stay valid.
      bar.classList.remove('is-collapsed');
      const barTop = bar.offsetTop; // relative to the sticky stage (scroll-independent)
      let lowestBox = 0;
      for (const box of boxes) {
        lowestBox = Math.max(lowestBox, box.offsetTop + box.offsetHeight);
      }
      bar.classList.toggle('is-collapsed', lowestBox + GAP > barTop);
    };

    window.addEventListener('resize', syncBar, { passive: true });
    window.addEventListener('orientationchange', syncBar, { passive: true });
    // Re-measure once fonts/images settle so box heights are final.
    window.addEventListener('load', syncBar);
    syncBar();
  }
</script>
