---
// The Canva opener rebuilt as ONE pinned stage. A single fixed background image
// sits behind a sticky viewport; the top-left nav crossfades three layers *in
// place* on the same screen — the scrambling name, the About cards, and the
// work box — dissolving one into the next without changing the page.
import { SITE } from '../site.config';

interface WorkPost {
  title: string;
  description: string;
  date: string;
  category: string;
  href: string;
}
interface WorkSection {
  name: string;
  slug: string;
  blurb: string;
  count: number;
  posts: WorkPost[];
}
interface Props {
  postsCount: number;
  projectsCount: number;
  years: number;
  latest: WorkPost[];
  sections: WorkSection[];
}
// Stats + list data are passed in from the page so they stay derived from real content.
const { postsCount, projectsCount, years, latest, sections } = Astro.props;

// Footer content moved up under the quote (the old dark footer bar is dropped
// on the home page). Same links/credit as Footer.astro.
const year = new Date().getFullYear();

const base = import.meta.env.BASE_URL;
const withBase = (p: string) => `${base}${p}`.replace(/\/{2,}/g, '/');

// Uppercase-first, as written by the author: "Louis".
const wordmark = 'Louis';

// About content.
const heading = 'Trinh Dat // Louis';
const affiliation = 'Investments Economics';
const bio = 'Investments student from UEH. Focus on finance, mathematics, econometrics.';
const fields = ['Finance', 'Mathematics', 'Econometrics'];

// Persistent top-left nav. Collapsed to a single "categories" grid icon; on
// hover it expands into a tall vertical strip down the left edge listing every
// destination. Home + About are scroll anchors; each category is a tab that
// swaps the work box in place. `key` doubles as the hash and the data-tab.
const menuIcon =
  '<svg viewBox="0 0 24 24" fill="currentColor" xmlns="http://www.w3.org/2000/svg"><path d="m10.357 13.262c-.049-.011-1.205-.262-2.357-.262s-2.309.251-2.357.262c-.19.042-.339.19-.381.381-.011.049-.262 1.205-.262 2.357s.251 2.309.262 2.357c.042.19.19.339.381.381.049.011 1.205.262 2.357.262s2.309-.251 2.357-.262c.19-.042.339-.19.381-.381.011-.049.262-1.205.262-2.357s-.251-2.309-.262-2.357c-.042-.19-.19-.339-.381-.381zm-.534 4.561c-.402.07-1.124.177-1.823.177s-1.421-.106-1.823-.177c-.07-.402-.177-1.124-.177-1.823s.106-1.421.177-1.823c.402-.07 1.124-.177 1.823-.177s1.421.106 1.823.177c.07.402.177 1.124.177 1.823s-.106 1.421-.177 1.823zm.534-12.561c-.049-.011-1.205-.262-2.357-.262s-2.309.251-2.357.262c-.19.042-.339.19-.381.381-.011.049-.262 1.205-.262 2.357s.251 2.309.262 2.357c.042.19.19.339.381.381.049.011 1.205.262 2.357.262s2.309-.251 2.357-.262c.19-.042.339-.19.381-.381.011-.049.262-1.205.262-2.357s-.251-2.309-.262-2.357c-.042-.19-.19-.339-.381-.381zm-.534 4.561c-.402.071-1.124.177-1.823.177s-1.421-.106-1.823-.177c-.07-.402-.177-1.124-.177-1.823s.106-1.421.177-1.823c.402-.071 1.124-.177 1.823-.177s1.421.106 1.823.177c.07.402.177 1.124.177 1.823s-.106 1.421-.177 1.823zm12.115-7.38c-.042-.191-.19-.34-.381-.381-.049-.011-4.891-1.062-9.558-1.062s-9.508 1.051-9.557 1.062c-.19.042-.339.19-.381.381-.011.048-1.062 4.891-1.062 9.557s1.051 9.509 1.062 9.558c.042.19.19.339.381.381.049.011 4.891 1.062 9.558 1.062s9.509-1.051 9.558-1.062c.19-.042.339-.19.381-.381.011-.049 1.062-4.891 1.062-9.558s-1.051-9.509-1.062-9.557zm-.911 18.584c-1.137.228-5.148.973-9.027.973s-7.891-.745-9.027-.973c-.228-1.137-.973-5.148-.973-9.027s.745-7.891.973-9.027c1.137-.228 5.148-.973 9.027-.973s7.891.745 9.027.973c.228 1.136.973 5.148.973 9.027s-.745 7.891-.973 9.027zm-2.67-15.765c-.049-.011-1.205-.262-2.357-.262s-2.309.251-2.357.262c-.19.042-.339.19-.381.381-.011.049-.262 1.205-.262 2.357s.251 2.309.262 2.357c.042.19.19.339.381.381.049.011 1.205.262 2.357.262s2.309-.251 2.357-.262c.19-.042.339-.19.381-.381.011-.049.262-1.205.262-2.357s-.251-2.309-.262-2.357c-.042-.19-.19-.339-.381-.381zm-.534 4.561c-.402.071-1.124.177-1.823.177s-1.421-.106-1.823-.177c-.07-.402-.177-1.124-.177-1.823s.106-1.421.177-1.823c.402-.071 1.124-.177 1.823-.177s1.421.106 1.823.177c.07.402.177 1.124.177 1.823s-.106 1.421-.177 1.823zm.534 3.439c-.049-.011-1.205-.262-2.357-.262s-2.309.251-2.357.262c-.19.042-.339.19-.381.381-.011.049-.262 1.205-.262 2.357s.251 2.309.262 2.357c.042.19.19.339.381.381.049.011 1.205.262 2.357.262s2.309-.251 2.357-.262c.19-.042.339-.19.381-.381.011-.049.262-1.205.262-2.357s-.251-2.309-.262-2.357c-.042-.19-.19-.339-.381-.381zm-.534 4.561c-.402.07-1.124.177-1.823.177s-1.421-.106-1.823-.177c-.07-.402-.177-1.124-.177-1.823s.106-1.421.177-1.823c.402-.07 1.124-.177 1.823-.177s1.421.106 1.823.177c.07.402.177 1.124.177 1.823s-.106 1.421-.177 1.823z"/></svg>';
const navIcons: Record<string, string> = {
  home: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M4 11 12 4l8 7"/><path d="M6 10v9h12v-9"/></svg>',
  about:
    '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="4"/><path d="M4 20c0-4 3.6-6 8-6s8 2 8 6"/></svg>',
  focus:
    '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="13" r="8"/><path d="M12 9v4l2.5 2"/><path d="M9 2h6"/></svg>',
  vault:
    '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="16" rx="2"/><circle cx="12" cy="12" r="4"/><path d="M12 12v-2M12 12l1.6 1.2"/><path d="M12 4v2M12 20v-2"/></svg>',
  courses:
    '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M4 5h7v15H6a2 2 0 0 1-2-2z"/><path d="M20 5h-7v15h5a2 2 0 0 0 2-2z"/></svg>',
  projects:
    '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M4 7a2 2 0 0 1 2-2h3l2 2h7a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2z"/></svg>',
};
const navItems = [
  { label: 'Home', href: '#home', key: 'home' },
  { label: 'About', href: '#about', key: 'about' },
  { label: 'Focus', href: '#focus', key: 'focus' },
  ...sections.map((s) => ({ label: s.name, href: `#${s.slug}`, key: s.slug })),
];
---

<section id="home" class="intro" aria-label="Introduction">
  <noscript>
    <style>
      /* Without JS there's no scroll crossfade — stack the two slides. */
      .intro { height: auto !important; }
      .intro__sticky { position: static !important; height: auto !important; }
      .intro__layer { position: static !important; opacity: 1 !important; filter: none !important; transform: none !important; min-height: 100svh; }
    </style>
  </noscript>

  <div class="intro__sticky">
    <!-- Nền tĩnh pixel-art (background.jpg) do .intro__sticky vẽ. -->
    <div class="intro__grade" aria-hidden="true"></div>

    <!-- Persistent top-left nav — collapsed to a single grid icon, expands on
         hover into a tall vertical strip. Present across all three slides;
         replaces the old bottom nav and the work-box rail. Category items carry
         data-tab to swap the box. The script flips it to open upward when
         opening downward would overrun the viewport bottom. -->
    <nav class="topnav" aria-label="Primary" data-topnav>
      <button
        class="topnav__toggle"
        type="button"
        aria-label="Toggle menu"
        aria-expanded="false"
        aria-controls="topnav-list"
        data-topnav-toggle
      >
        <span class="topnav__ic topnav__ic--menu" set:html={menuIcon} />
      </button>
      <ul class="topnav__list" id="topnav-list">
        {
          navItems.map((it) => (
            <li>
              <a class="topnav__item" href={it.href} data-tab={it.key}>
                <span class="topnav__ic" set:html={navIcons[it.key]} />
                <span class="topnav__label">{it.label}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <!-- Layer 1 — the name, revealed by a slow decoding scramble that cycles
         between "Louis" and "Hello" forever. JS drives the per-character spans;
         the static label keeps it accessible / correct without JS. -->
    <div class="intro__layer intro__layer--name">
      <h1 class="intro__mark">
        <span class="intro__ink" data-scramble aria-hidden="true">{wordmark}</span>
        <span class="sr-only">{wordmark}</span>
      </h1>
    </div>

    <!-- Layer 2 — the About cards -->
    <div class="intro__layer intro__layer--about" aria-labelledby="about-heading">
      <h2 id="about-heading" class="sr-only">About</h2>
      <div class="about__grid">
        <!-- Left — identity, quick links, live stats -->
        <article class="glass about__id">
          <div class="about__id-top">
            <p class="about__name">{heading}</p>
            <p class="about__affil">{affiliation}</p>
            <div class="about__links">
              <a class="about__pill" href="#work">Latest posts</a>
              <a class="about__pill" href="#work">Sections</a>
            </div>
          </div>
          <div class="about__stats">
            <div class="about__stat">
              <span class="about__num tnum">{postsCount}</span>
              <span class="about__lbl">Posts</span>
            </div>
            <div class="about__stat">
              <span class="about__num tnum">{projectsCount}</span>
              <span class="about__lbl">Projects</span>
            </div>
            <div class="about__stat">
              <span class="about__num tnum">{years}<span class="about__unit">yr</span></span>
              <span class="about__lbl">Active</span>
            </div>
          </div>
        </article>

        <!-- Right — bio + fields of study -->
        <div class="about__side">
          <article class="glass about__bio">
            <p>{bio}</p>
          </article>
          <ul class="about__fields">
            {fields.map((f) => <li class="glass about__field">{f}</li>)}
          </ul>
        </div>
      </div>
    </div>

    <!-- Layer 2b — Focus: a self-contained Pomodoro timer. No audio / Spotify
         yet (author will add later). Durations, round counter, auto-start and a
         small task list persist to localStorage. Driven entirely client-side. -->
    <div class="intro__layer intro__layer--focus" aria-labelledby="focus-heading" data-pomo>
      <h2 id="focus-heading" class="sr-only">Focus timer</h2>
      <div class="pomo">
        <!-- Mode switch -->
        <div class="pomo__modes" role="tablist" aria-label="Timer mode">
          <button class="pomo__mode is-active" data-mode="focus" type="button" role="tab" aria-selected="true">Pomodoro</button>
          <button class="pomo__mode" data-mode="short" type="button" role="tab" aria-selected="false">Short Break</button>
          <button class="pomo__mode" data-mode="long" type="button" role="tab" aria-selected="false">Long Break</button>
        </div>

        <!-- The clock -->
        <div class="pomo__clock">
          <div class="pomo__timerow">
            <button class="pomo__adjust" data-adjust="-1" type="button" aria-label="Decrease time by 1 minute">−</button>
            <p class="pomo__time" data-time aria-live="off">25:00</p>
            <button class="pomo__adjust" data-adjust="1" type="button" aria-label="Increase time by 1 minute">+</button>
          </div>
          <p class="pomo__status" data-status>Time to focus.</p>
        </div>

        <!-- Controls -->
        <div class="pomo__controls">
          <button class="pomo__btn pomo__btn--main" data-toggle type="button">Start</button>
          <button class="pomo__btn" data-reset type="button" aria-label="Reset current timer">Reset</button>
          <button class="pomo__btn" data-skip type="button" aria-label="Skip to next session">Skip</button>
        </div>

        <p class="pomo__round">Round <span class="pomo__round-num" data-round>1</span> · <span data-completed>0</span> pomodoros done</p>

        <!-- Task list -->
        <div class="pomo__tasks">
          <form class="pomo__add" data-task-form>
            <input class="pomo__input" data-task-input type="text" placeholder="Add a task to focus on…" maxlength="120" autocomplete="off" />
            <button class="pomo__btn pomo__btn--add" type="submit" aria-label="Add task">+</button>
          </form>
          <ul class="pomo__list" data-task-list></ul>
        </div>

        <!-- Settings -->
        <details class="pomo__settings">
          <summary class="pomo__settings-sum">Settings</summary>
          <div class="pomo__settings-grid">
            <label class="pomo__field">Pomodoro
              <input type="number" min="1" max="120" data-set="focus" value="25" /><span class="pomo__unit">min</span>
            </label>
            <label class="pomo__field">Short break
              <input type="number" min="1" max="60" data-set="short" value="5" /><span class="pomo__unit">min</span>
            </label>
            <label class="pomo__field">Long break
              <input type="number" min="1" max="60" data-set="long" value="15" /><span class="pomo__unit">min</span>
            </label>
            <label class="pomo__field">Long break every
              <input type="number" min="2" max="12" data-set="interval" value="4" /><span class="pomo__unit">rounds</span>
            </label>
            <label class="pomo__field pomo__field--check">
              <input type="checkbox" data-set="auto" /> Auto-start next session
            </label>
          </div>
        </details>
      </div>
    </div>

    <!-- Layer 3 — merged "Latest posts" + "Sections" panel -->
    <div class="intro__layer intro__layer--work" aria-labelledby="work-heading">
      <h2 id="work-heading" class="sr-only">Latest posts and sections</h2>
      <div class="work glass">
        <!-- One swappable view per tab. Home = latest posts; each section shows
             its own title + posts. Only the active view is displayed. -->
        <div class="work__body">
          <div class="work__view is-active" data-view="home">
            <div class="work__head">
              <h3 class="work__title">Latest posts</h3>
            </div>
            <ul class="work__posts">
              {
                latest.map((p) => (
                  <li>
                    <a class="wpost" href={p.href}>
                      <div class="wpost__main">
                        <p class="wpost__title">{p.title}</p>
                        <p class="wpost__desc">{p.description}</p>
                        <p class="wpost__date">{p.date}</p>
                      </div>
                      <span class="wpost__cat">{p.category}</span>
                    </a>
                  </li>
                ))
              }
            </ul>
          </div>

          {
            sections.map((s) => (
              <div class="work__view" data-view={s.slug} aria-label={s.name}>
                <div class="work__head">
                  <h3 class="work__title">{s.name}</h3>
                  <span class="work__count">
                    {s.count} {s.count === 1 ? 'essay' : 'essays'}
                  </span>
                </div>
                {s.posts.length > 0 ? (
                  <ul class="work__posts">
                    {s.posts.map((p) => (
                      <li>
                        <a class="wpost" href={p.href}>
                          <div class="wpost__main">
                            <p class="wpost__title">{p.title}</p>
                            <p class="wpost__desc">{p.description}</p>
                            <p class="wpost__date">{p.date}</p>
                          </div>
                          <span class="wpost__cat">{p.category}</span>
                        </a>
                      </li>
                    ))}
                  </ul>
                ) : (
                  <p class="work__empty">
                    Nothing here yet — the first essay in this section is on its way.
                  </p>
                )}
              </div>
            ))
          }
        </div>
      </div>
    </div>

    <!-- Persistent footer quote (nav moved to the fixed top-left rail). The old
         dark footer bar's content now sits right under the quote, in white. -->
    <div class="intro__bar">
      {
        SITE.hero.quotes.length > 0 && (
          <div class="intro__quotes">
            {SITE.hero.quotes.map((q) => (
              <p class="intro__quote">{q}</p>
            ))}
          </div>
        )
      }
      <p class="intro__foot">
        <span class="intro__foot-mark">{SITE.title}</span>
        {
          SITE.links.map((l) => (
            <>
              <span class="intro__foot-sep" aria-hidden="true">·</span>
              <a class="intro__foot-link" href={l.href}>{l.label}</a>
            </>
          ))
        }
        <span class="intro__foot-sep" aria-hidden="true">·</span>
        <span class="intro__foot-copy">© {year}</span>
      </p>
    </div>
  </div>

</section>

<style define:vars={{ meadow: `url('${withBase('/background.jpg')}')` }}>
  /* One fixed screen; the nav crossfades the layers in place (no page change). */
  .intro {
    position: relative;
    /* One fixed screen — no scroll travel. The nav (not scrolling) crossfades
       between the wordmark, About and the work box. */
    height: 100svh;
    background: var(--color-ink);
  }

  .intro__sticky {
    position: relative;
    top: 0;
    height: 100svh;
    overflow: clip;
    isolation: isolate;
    /* Fixed painterly meadow — locked to the viewport (Canva slide feel). */
    background-image: var(--meadow);
    background-size: cover;
    background-position: 50% 50%;
    background-attachment: fixed;
    color: var(--hero-ink);
  }

  .intro__grade {
    position: absolute;
    inset: 0;
    z-index: 0;
    background:
      radial-gradient(120% 90% at 50% 42%, transparent 58%, var(--hero-wash) 100%),
      linear-gradient(to bottom, transparent 58%, var(--hero-scrim) 100%);
    pointer-events: none;
  }

  /* All three layers occupy the same centred box; the nav crossfades one into
     the next in place (opacity/blur/scale animate via these transitions). Only
     the active layer is interactive. In the no-JS/static fallback they stack. */
  .intro__layer {
    position: absolute;
    inset: 0;
    z-index: 1;
    display: grid;
    place-items: center;
    padding: clamp(3rem, 8vh, 6rem) var(--page-gutter) clamp(6rem, 14vh, 9rem);
    pointer-events: none;
    transition:
      opacity 520ms var(--ease-in-out),
      filter 520ms var(--ease-in-out),
      transform 520ms var(--ease-in-out);
  }
  .intro__layer.is-active {
    pointer-events: auto;
  }
  .intro__layer--name {
    opacity: var(--name-op, 1);
  }
  .intro__layer--about {
    opacity: var(--about-op, 0);
    filter: blur(calc((1 - var(--about-op, 0)) * 16px));
    transform: scale(calc(0.97 + var(--about-op, 0) * 0.03));
  }
  .intro__layer--work {
    opacity: var(--work-op, 0);
    filter: blur(calc((1 - var(--work-op, 0)) * 16px));
    transform: scale(calc(0.97 + var(--work-op, 0) * 0.03));
  }
  .intro__layer--focus {
    opacity: var(--focus-op, 0);
    filter: blur(calc((1 - var(--focus-op, 0)) * 16px));
    transform: scale(calc(0.97 + var(--focus-op, 0) * 0.03));
  }

  /* ---- The scrambling wordmark (Crude font) ---- */
  .intro__mark {
    margin: 0;
    line-height: 1.15;
    text-align: center;
  }
  .intro__ink {
    position: relative;
    display: inline-flex;
    justify-content: center;
    align-items: baseline;
    font-family: var(--font-crude);
    font-weight: 400;
    /* ▼▼ ĐỔI KÍCH THƯỚC CHỮ "LOUIS/HELLO" TẠI ĐÂY ▼▼
       clamp(nhỏ-nhất-trên-mobile, co-giãn-theo-màn-hình, lớn-nhất-trên-desktop)
       Muốn chữ nhỏ lại: giảm cả 3 số, ví dụ clamp(3rem, 12vw, 9rem). */
    font-size: clamp(2rem, 7.5vw, 5.4rem);
    /* ▲▲ ---------------------------------------- ▲▲ */
    line-height: 1.3;
    padding: 0.14em 0.16em 0.24em;
    letter-spacing: 0.02em;
    color: var(--hero-ink);
    text-shadow: 0 2px 26px color-mix(in oklch, var(--shadow-color) 55%, transparent);
    /* Bóng đổ theo đèn: `filter` áp cho cả cụm chữ (không bị các span con ghi
       đè như text-shadow), nên mỗi lần đèn chớp, chữ hắt bóng cứng sang trái —
       ngược hướng ngọn đèn ở góc phải trong ảnh nền. */
    animation: louis-lamp-shadow 7s steps(1, end) infinite;
    will-change: filter;
  }
  /* Each character is its own cell so scramble glyphs of different widths don't
     shove the line around — a fixed min-width keeps positions calm and steady. */
  .intro__char {
    display: inline-block;
    min-width: 0.62em;
    text-align: center;
    /* When a settled char is un-flashed, it eases from the accent back to snow,
       giving the "lock" a soft glow that fades rather than a hard blink. */
    transition:
      color 620ms var(--ease-out),
      text-shadow 620ms var(--ease-out);
  }
  /* Mid-scramble glyphs sit slightly dimmer so the locked letters read first. */
  .intro__char--scramble {
    color: color-mix(in oklch, var(--hero-ink) 62%, transparent);
  }
  /* The instant a character locks into place — a gentle warm-gold accent glow. */
  .intro__char--lock {
    color: var(--color-light-gold);
    text-shadow:
      0 0 18px color-mix(in oklch, var(--color-light-gold) 70%, transparent),
      0 2px 26px color-mix(in oklch, var(--shadow-color) 55%, transparent);
  }

  /* Bóng chữ "Louis" — bật thành hai đợt nhấp nháy trong mỗi vòng 7s (kiểu đèn
     chập chờn), hắt sang trái (ngược hướng đèn ở góc phải). Ngoài các mốc đó thì
     không có bóng. steps(1) cho ra cú chớp dứt khoát, không mờ dần. */
  @keyframes louis-lamp-shadow {
    0%, 38% { filter: drop-shadow(0 0 0 rgba(0, 0, 0, 0)); }
    39% { filter: drop-shadow(-7px 9px 4px rgba(4, 6, 22, 0.65)); }
    40% { filter: drop-shadow(0 0 0 rgba(0, 0, 0, 0)); }
    41% { filter: drop-shadow(-7px 9px 4px rgba(4, 6, 22, 0.65)); }
    43%, 68% { filter: drop-shadow(0 0 0 rgba(0, 0, 0, 0)); }
    69% { filter: drop-shadow(-8px 10px 5px rgba(4, 6, 22, 0.7)); }
    70% { filter: drop-shadow(0 0 0 rgba(0, 0, 0, 0)); }
    71% { filter: drop-shadow(-8px 10px 5px rgba(4, 6, 22, 0.7)); }
    73% { filter: drop-shadow(0 0 0 rgba(0, 0, 0, 0)); }
    74%, 100% { filter: drop-shadow(0 0 0 rgba(0, 0, 0, 0)); }
  }
  /* Người dùng tắt hiệu ứng chuyển động: giữ chữ tĩnh, không chớp bóng. */
  @media (prefers-reduced-motion: reduce) {
    .intro__ink { animation: none; }
  }

  /* ---- About cards ---- */
  .about__grid {
    width: 100%;
    max-width: var(--content-max);
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: clamp(1.25rem, 3vw, 2rem);
    align-items: stretch;
  }
  .glass {
    margin: 0;
    background: color-mix(in srgb, var(--color-glass) calc(var(--glass-alpha) * 100%), transparent);
    -webkit-backdrop-filter: blur(6px);
    backdrop-filter: blur(6px);
    border: 1px solid color-mix(in oklch, var(--sheen-color) 35%, transparent);
    border-radius: var(--radius-lg);
    /* Deeper, layered shadow so the cards lift off the meadow. */
    box-shadow:
      0 34px 80px color-mix(in oklch, var(--shadow-color) 42%, transparent),
      0 12px 28px color-mix(in oklch, var(--shadow-color) 26%, transparent);
  }
  /* ---- Left: identity card (name, quick links, stats) ---- */
  .about__id {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: clamp(1.5rem, 5vh, 3rem);
    padding: clamp(1.75rem, 4vw, 3.25rem);
  }
  .about__name {
    margin: 0;
    font-family: var(--font-body);
    font-weight: 700;
    font-size: clamp(1.85rem, 4.4vw, 3rem);
    line-height: 1.03;
    letter-spacing: 0.01em;
    color: var(--color-ink);
  }
  .about__affil {
    margin: var(--space-2xs) 0 0;
    font-family: var(--font-body);
    font-weight: 400;
    font-size: clamp(1rem, 2.2vw, 1.375rem);
    letter-spacing: 0.12em;
    color: var(--color-ink-2);
  }
  .about__links {
    margin-top: clamp(1rem, 3vh, 1.75rem);
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2xs);
  }
  .about__pill {
    font-family: var(--font-body);
    font-size: var(--text-sm);
    font-weight: 600;
    letter-spacing: 0.08em;
    color: var(--color-ink);
    padding: 0.6rem 1.15rem;
    border-radius: 999px;
    background: color-mix(in srgb, var(--color-glass) 82%, transparent);
    border: 1px solid color-mix(in oklch, var(--sheen-color) 40%, transparent);
    box-shadow: 0 6px 16px color-mix(in oklch, var(--shadow-color) 18%, transparent);
    transition: transform var(--dur-short) var(--ease-out),
      background-color var(--dur-short) var(--ease-out);
  }
  .about__pill:hover {
    transform: translateY(-2px);
    background: color-mix(in srgb, var(--color-glass) 95%, transparent);
  }

  /* Stats row (numbers stay derived from real content) */
  .about__stats {
    display: flex;
    flex-wrap: wrap;
    gap: clamp(1rem, 4vw, 2.5rem);
    font-family: var(--font-body);
  }
  .about__stat {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }
  .about__num {
    font-weight: 700;
    font-size: clamp(2.1rem, 4.6vw, 3.1rem);
    line-height: 1;
    color: var(--color-ink);
  }
  .about__unit {
    font-size: 0.5em;
    margin-left: 0.06em;
  }
  .about__lbl {
    margin-top: var(--space-3xs);
    font-size: var(--text-sm);
    font-weight: 700;
    letter-spacing: 0.14em;
    color: var(--color-ink);
  }

  /* ---- Right: bio card + fields of study ---- */
  .about__side {
    display: flex;
    flex-direction: column;
    gap: clamp(0.9rem, 2vw, 1.5rem);
  }
  .about__bio {
    padding: clamp(1.5rem, 3.5vw, 2.25rem);
    display: grid;
    place-items: center;
    text-align: center;
  }
  .about__bio p {
    margin: 0;
    font-family: var(--font-body);
    font-weight: 700;
    font-size: clamp(0.95rem, 1.7vw, 1.25rem);
    line-height: 1.4;
    letter-spacing: 0.04em;
    color: var(--color-ink);
  }
  .about__fields {
    list-style: none;
    margin: 0;
    padding: 0;
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: clamp(0.9rem, 2vw, 1.5rem);
  }
  .about__field {
    flex: 1;
    display: grid;
    place-items: center;
    min-height: 3.25rem;
    padding: 0.75rem 1rem;
    font-family: var(--font-body);
    font-size: var(--text-md);
    font-weight: 600;
    letter-spacing: 0.12em;
    color: var(--color-ink);
    /* Lighter than the big cards. */
    box-shadow: 0 10px 24px color-mix(in oklch, var(--shadow-color) 22%, transparent);
  }

  /* ---- Layer 2b: Focus / Pomodoro ----
     No box — the timer sits straight on the background photo, so every element
     is white (--hero-ink) with a soft shadow for legibility. JetBrains Mono to
     match the post pages and the timer's numeric feel. */
  .pomo {
    width: 100%;
    max-width: min(94vw, 36rem);
    max-height: min(86vh, 46rem);
    overflow-y: auto;
    overscroll-behavior: contain;
    padding: clamp(1.4rem, 3.5vw, 2.4rem);
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: clamp(1rem, 2.6vh, 1.6rem);
    text-align: center;
    font-family: var(--font-post);
    color: var(--hero-ink);
    text-shadow: 0 1px 16px color-mix(in oklch, var(--shadow-color) 62%, transparent);
  }

  /* Mode switch — three white pills; the active one fills with a soft white wash. */
  .pomo__modes {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.4rem;
  }
  .pomo__mode {
    font-family: var(--font-post);
    font-size: var(--text-sm);
    font-weight: 600;
    letter-spacing: 0.02em;
    color: var(--hero-ink);
    padding: 0.5rem 0.95rem;
    border-radius: 999px;
    border: 1px solid transparent;
    background: transparent;
    cursor: pointer;
    transition: background-color var(--dur-short) var(--ease-out);
  }
  .pomo__mode:hover {
    background: color-mix(in oklch, var(--hero-ink) 12%, transparent);
  }
  .pomo__mode.is-active {
    background: color-mix(in oklch, var(--hero-ink) 22%, transparent);
    font-weight: 800;
  }

  /* The clock */
  .pomo__clock { margin: clamp(0.5rem, 2vh, 1.25rem) 0; }
  /* Time + the small −/+ steppers on either side. */
  .pomo__timerow {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: clamp(0.6rem, 2vw, 1.1rem);
  }
  .pomo__adjust {
    flex: 0 0 auto;
    display: grid;
    place-items: center;
    width: 2.2rem;
    height: 2.2rem;
    padding: 0;
    font-family: var(--font-post);
    font-size: 1.35rem;
    line-height: 1;
    color: var(--hero-ink);
    background: color-mix(in oklch, var(--hero-ink) 10%, transparent);
    border: 1px solid color-mix(in oklch, var(--hero-ink) 34%, transparent);
    border-radius: 999px;
    cursor: pointer;
    transition: background-color var(--dur-short) var(--ease-out),
      transform var(--dur-short) var(--ease-out);
  }
  .pomo__adjust:hover {
    background: color-mix(in oklch, var(--hero-ink) 22%, transparent);
    transform: translateY(-1px);
  }
  .pomo__adjust:active { transform: translateY(0); }
  .pomo__time {
    margin: 0;
    /* Same face as the "Louis" hero wordmark (Crude). Crude glyphs are wide, so
       keep it on one line and sized to fit the card — the last digit was being
       clipped by the card's horizontal overflow before. */
    font-family: var(--font-crude);
    font-weight: 400;
    font-size: clamp(3.4rem, 14vw, 6.6rem);
    line-height: 1.1;
    letter-spacing: 0.01em;
    white-space: nowrap;
    font-variant-numeric: tabular-nums;
    color: var(--hero-ink);
  }
  .pomo__status {
    margin: 0.5rem 0 0;
    font-size: var(--text-sm);
    letter-spacing: 0.04em;
    color: color-mix(in oklch, var(--hero-ink) 80%, transparent);
  }

  /* Controls */
  .pomo__controls {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 0.6rem;
  }
  .pomo__btn {
    font-family: var(--font-post);
    font-size: var(--text-sm);
    font-weight: 600;
    letter-spacing: 0.04em;
    color: var(--hero-ink);
    padding: 0.65rem 1.2rem;
    border-radius: 999px;
    border: 1px solid color-mix(in oklch, var(--hero-ink) 34%, transparent);
    background: transparent;
    cursor: pointer;
    transition: background-color var(--dur-short) var(--ease-out),
      transform var(--dur-short) var(--ease-out);
  }
  .pomo__btn:hover {
    background: color-mix(in oklch, var(--hero-ink) 14%, transparent);
    transform: translateY(-1px);
  }
  /* Primary Start/Pause — filled with the brand's fern accent. */
  .pomo__btn--main {
    min-width: 8.5rem;
    padding: 0.75rem 1.6rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-accent-ink);
    background: var(--color-accent);
    border-color: transparent;
    box-shadow: 0 8px 20px color-mix(in oklch, var(--color-accent) 40%, transparent);
  }
  .pomo__btn--main:hover {
    background: var(--color-accent-strong);
  }

  .pomo__round {
    margin: 0;
    font-size: var(--text-xs);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: color-mix(in oklch, var(--hero-ink) 62%, transparent);
  }
  .pomo__round-num { font-weight: 800; color: var(--hero-ink); }

  /* Task list */
  .pomo__tasks {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    border-top: 1px solid color-mix(in oklch, var(--hero-ink) 20%, transparent);
    padding-top: clamp(0.9rem, 2vh, 1.25rem);
  }
  .pomo__add { display: flex; gap: 0.5rem; }
  .pomo__input {
    flex: 1;
    min-width: 0;
    font-family: var(--font-post);
    font-size: var(--text-sm);
    color: var(--hero-ink);
    padding: 0.6rem 0.85rem;
    border-radius: var(--radius-md);
    border: 1px solid color-mix(in oklch, var(--hero-ink) 30%, transparent);
    background: color-mix(in oklch, var(--hero-ink) 10%, transparent);
  }
  .pomo__input::placeholder { color: color-mix(in oklch, var(--hero-ink) 55%, transparent); }
  .pomo__input:focus-visible {
    outline: 2px solid var(--color-light-gold);
    outline-offset: 1px;
  }
  .pomo__btn--add {
    flex: 0 0 auto;
    width: 2.75rem;
    padding: 0;
    font-size: var(--text-md);
    line-height: 1;
  }
  .pomo__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    text-align: left;
  }
  /* Task rows are built in JS (createElement), so they never receive Astro's
     scoped data-attribute — target them via :global() or the scoped rules won't
     match. Namespaced under .pomo so nothing leaks to the rest of the site. */
  .pomo :global(.pomo__task) {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.55rem 0.7rem;
    border-radius: var(--radius-md);
    background: color-mix(in oklch, var(--hero-ink) 10%, transparent);
    border: 1px solid color-mix(in oklch, var(--hero-ink) 16%, transparent);
  }
  .pomo :global(.pomo__task input[type='checkbox']) {
    flex: 0 0 auto;
    width: 1.05rem;
    height: 1.05rem;
    accent-color: var(--color-accent);
    cursor: pointer;
  }
  .pomo :global(.pomo__task-text) {
    flex: 1;
    min-width: 0;
    font-size: var(--text-sm);
    color: var(--hero-ink);
    word-break: break-word;
  }
  .pomo :global(.pomo__task.is-done .pomo__task-text) {
    text-decoration: line-through;
    color: color-mix(in oklch, var(--hero-ink) 52%, transparent);
  }
  .pomo :global(.pomo__task-del) {
    flex: 0 0 auto;
    border: 0;
    background: transparent;
    color: color-mix(in oklch, var(--hero-ink) 62%, transparent);
    font-size: var(--text-md);
    line-height: 1;
    cursor: pointer;
    padding: 0 0.25rem;
    transition: color var(--dur-short) var(--ease-out);
  }
  .pomo :global(.pomo__task-del:hover) { color: var(--hero-ink); }

  /* Settings */
  .pomo__settings {
    text-align: left;
    border-top: 1px solid color-mix(in oklch, var(--hero-ink) 20%, transparent);
    padding-top: clamp(0.9rem, 2vh, 1.25rem);
  }
  .pomo__settings-sum {
    cursor: pointer;
    font-size: var(--text-sm);
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: color-mix(in oklch, var(--hero-ink) 82%, transparent);
    list-style: none;
  }
  .pomo__settings-sum::-webkit-details-marker { display: none; }
  .pomo__settings-sum::before {
    content: '▸';
    display: inline-block;
    margin-right: 0.5rem;
    transition: transform var(--dur-short) var(--ease-out);
  }
  .pomo__settings[open] .pomo__settings-sum::before { transform: rotate(90deg); }
  .pomo__settings-grid {
    margin-top: 0.9rem;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.7rem 1rem;
  }
  .pomo__field {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: var(--text-sm);
    color: color-mix(in oklch, var(--hero-ink) 82%, transparent);
  }
  .pomo__field input[type='number'] {
    width: 3.4rem;
    margin-left: auto;
    font-family: var(--font-post);
    font-size: var(--text-sm);
    color: var(--hero-ink);
    text-align: center;
    padding: 0.35rem 0.4rem;
    border-radius: var(--radius-sm);
    border: 1px solid color-mix(in oklch, var(--hero-ink) 30%, transparent);
    background: color-mix(in oklch, var(--hero-ink) 10%, transparent);
  }
  .pomo__field--check {
    grid-column: 1 / -1;
    gap: 0.55rem;
  }
  .pomo__field--check input[type='checkbox'] {
    width: 1.05rem;
    height: 1.05rem;
    accent-color: var(--color-accent);
    cursor: pointer;
  }
  .pomo__unit {
    font-size: var(--text-xs);
    color: color-mix(in oklch, var(--hero-ink) 55%, transparent);
  }

  @media (max-width: 480px) {
    .pomo__settings-grid { grid-template-columns: 1fr; }
  }

  /* ---- Zen focus mode ----
     While the timer is running, the script adds .is-focusing to the stage.
     Strip the Focus extras — the footer/quote, the mode tabs, the −/+ steppers,
     the status line, the round counter and the settings — leaving the clock, the
     task section and the Pause/Reset/Skip controls. The nav rail stays so you
     can still move around (the timer keeps running in the background). */
  .intro.is-focusing .intro__bar,
  .intro.is-focusing .pomo__modes,
  .intro.is-focusing .pomo__adjust,
  .intro.is-focusing .pomo__status,
  .intro.is-focusing .pomo__round,
  .intro.is-focusing .pomo__settings {
    display: none;
  }

  /* ---- Layer 3: latest-post boxes + section-nav rail ---- */
  .work {
    position: relative;
    width: 100%;
    max-width: min(94vw, 72rem);
    /* Fixed height so the box never resizes when switching sections — sections
       with few posts keep the same size instead of shrinking (long lists scroll
       inside via .work__posts). */
    height: min(82vh, 40rem);
    display: flex;
    align-items: stretch;
    padding: clamp(1.1rem, 2.4vw, 1.9rem);
  }

  /* ---- Persistent top-left nav rail ----
     Pinned to the top-left of the sticky stage, present on every slide.
     Collapsed it shows a single grid icon; on hover it expands into a tall
     vertical strip down the left edge, revealing every destination with labels.
     `.is-up` (set by the script) flips it to open upward — used when opening
     downward would run past the bottom of the viewport / into content. */
  .topnav {
    position: absolute;
    top: clamp(1.1rem, 2.4vw, 1.9rem);
    left: clamp(1.1rem, 2.4vw, 1.9rem);
    z-index: 5;
    /* Collapsed: a fixed square that snugly wraps the toggle (2.5rem icon box +
       2×0.6rem padding + 1px borders), so the icon reads perfectly centred at any
       screen scale — no viewport-relative width to drift. `gap` is 0 while
       collapsed so the (empty) list below doesn't push the icon off-centre; it
       returns on hover to space the toggle from the list. */
    width: 3.85rem;
    display: flex;
    flex-direction: column;
    gap: 0;
    padding: 0.6rem;
    border-radius: 1.6rem;
    /* Cùng chất "kính mờ" với box chứa bài viết (.glass): nền Snow 60% + viền
       sheen 35%, nên thanh nav và box đọc như cùng một vật liệu. */
    background: color-mix(in srgb, var(--color-glass) calc(var(--glass-alpha) * 100%), transparent);
    -webkit-backdrop-filter: blur(14px);
    backdrop-filter: blur(14px);
    border: 1px solid color-mix(in oklch, var(--sheen-color) 35%, transparent);
    box-shadow: 0 18px 40px color-mix(in oklch, var(--shadow-color) 45%, transparent);
    overflow: hidden;
    /* Slow, mellow open/close. */
    transition: width 680ms var(--ease-in-out);
  }
  /* Open upward: bottom is pinned (in px, by the script) and the children stack
     in reverse so the grid icon stays put while items grow above it. */
  .topnav.is-up {
    top: auto;
    flex-direction: column-reverse;
  }
  /* Explicit open (tap the grid icon) — works on touch, where there's no hover. */
  .topnav.is-open {
    width: clamp(12rem, 17vw, 14rem);
    gap: 0.4rem;
  }
  /* Hover-to-open only where a real pointer can hover; on touch it would "stick"
     open with no way to dismiss, so touch relies on the toggle button instead. */
  @media (hover: hover) {
    .topnav:hover,
    .topnav:focus-within {
      width: clamp(12rem, 17vw, 14rem);
      gap: 0.4rem;
    }
  }

  /* Collapsed handle — the grid icon that's always visible. Always pinned to the
     left of the column (both collapsed and expanded, so it never drifts to the
     middle); the glyph is centred inside its own square box via place-items. When
     collapsed the pill is exactly this box's width, so "left" reads as centred. */
  .topnav__toggle {
    flex: 0 0 auto;
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    margin-inline: 0;
    padding: 0;
    border: 0;
    border-radius: 0.9rem;
    background: transparent;
    color: var(--color-ink);
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
    /* On touch (no hover) the strip only opens via this button, so give it a
       clear pressed state. */
    transition: background-color var(--dur-short) var(--ease-out);
  }
  .topnav.is-open .topnav__toggle {
    background: color-mix(in oklch, var(--color-ink) 10%, transparent);
  }
  .topnav__ic--menu :global(svg) {
    width: 1.55rem;
    height: 1.55rem;
  }

  .topnav__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
    /* Hidden until hover — clipped so the collapsed pill is just the icon. */
    max-height: 0;
    opacity: 0;
    overflow: hidden;
    transition:
      max-height 680ms var(--ease-in-out),
      opacity 520ms var(--ease-in-out);
  }
  .topnav.is-up .topnav__list {
    flex-direction: column-reverse;
  }
  .topnav.is-open .topnav__list {
    max-height: 80vh;
    opacity: 1;
  }
  @media (hover: hover) {
    .topnav:hover .topnav__list,
    .topnav:focus-within .topnav__list {
      max-height: 80vh;
      opacity: 1;
    }
  }
  .topnav__item {
    display: flex;
    align-items: center;
    /* Icons stay left-aligned in every state so they don't snap to the middle
       (like the toggle) while the strip collapses — the list is hidden when
       collapsed, so left alignment is only ever seen while open. */
    justify-content: flex-start;
    /* Taller items so the expanded strip reads as a long left-edge bar. */
    padding: 0.7rem 0.55rem;
    border-radius: 0.9rem;
    color: var(--color-ink);
    white-space: nowrap;
    transition: background-color var(--dur-short) var(--ease-out);
  }
  .topnav__item:hover {
    background: color-mix(in oklch, var(--color-ink) 10%, transparent);
  }
  /* Active tab (the view currently shown in the box) — solid warm gold so it
     clearly stands out against the dark rail, not the muted fern accent. */
  .topnav__item[data-current],
  .topnav__item[data-current]:hover {
    background: var(--color-light-gold);
    color: var(--color-ink);
    box-shadow: 0 4px 14px color-mix(in oklch, var(--color-light-gold) 45%, transparent);
  }
  .topnav__ic {
    flex: 0 0 auto;
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
  }
  .topnav__ic :global(svg) {
    width: 1.25rem;
    height: 1.25rem;
  }
  .topnav__label {
    font-family: var(--font-post);
    font-size: var(--text-sm);
    font-weight: 600;
    letter-spacing: 0.02em;
    max-width: 0;
    margin-left: 0;
    overflow: hidden;
    opacity: 0;
    transform: translateX(-6px);
    transition: max-width 680ms var(--ease-in-out),
