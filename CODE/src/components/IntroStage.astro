  /* ---- Persistent footer ---- */
  .intro__bar {
    position: absolute;
    left: 0;
    right: 0;
    bottom: clamp(1.5rem, 4vw, 3rem);
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-md);
    text-align: center;
    padding-inline: var(--page-gutter);
    animation: intro-rise var(--dur-long) var(--ease-out) 2200ms both;
  }
