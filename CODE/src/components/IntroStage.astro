  }
  .work__head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-md);
    padding-bottom: var(--space-2xs);
    border-bottom: 2px solid color-mix(in oklch, var(--color-fern) 40%, transparent);
