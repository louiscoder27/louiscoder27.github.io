---
// Fixed top-right dark/light toggle. Shared by the reader post pages and the
// admin pages so both flip together (same `post-theme` preference key).
// Requires the page to be rendered with BaseLayout's `themeToggle` prop (which
// adds `body.post-page` + the no-flash init script).
---

<button
  id="theme-toggle"
  class="theme-toggle"
  type="button"
  aria-pressed="false"
  aria-label="Switch to dark theme"
  title="Toggle dark mode"
>
  <svg class="theme-toggle__icon theme-toggle__sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <circle cx="12" cy="12" r="4"></circle>
    <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"></path>
  </svg>
  <svg class="theme-toggle__icon theme-toggle__moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
  </svg>
</button>

<style>
  .theme-toggle {
    position: fixed;
    top: var(--space-md);
    right: var(--space-md);
    z-index: var(--z-overlay);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.75rem;
    height: 2.75rem;
    padding: 0;
    color: var(--color-accent);
    background: var(--color-paper-2);
    border: var(--rule-hair) solid var(--color-accent);
    border-radius: 999px;
    cursor: pointer;
    box-shadow: 0 2px 10px color-mix(in oklch, var(--shadow-color) 18%, transparent);
    transition: background-color var(--dur-short) var(--ease-out),
      color var(--dur-short) var(--ease-out),
      transform var(--dur-instant) var(--ease-out);
  }
  .theme-toggle:hover {
    background-color: var(--color-accent);
    color: var(--color-accent-ink);
  }
  .theme-toggle:active {
    transform: translateY(1px);
  }
  .theme-toggle__icon {
    width: 1.35rem;
    height: 1.35rem;
  }
  /* Sun in light mode, Moon in dark mode. */
  .theme-toggle__moon {
    display: none;
  }
  html[data-theme='dark'] .theme-toggle__sun {
    display: none;
  }
  html[data-theme='dark'] .theme-toggle__moon {
    display: inline;
  }
</style>

<script is:inline>
  (function () {
    var root = document.documentElement;
    var btn = document.getElementById('theme-toggle');
    if (!btn) return;
    var KEY = 'post-theme';
    function apply(dark) {
      root.setAttribute('data-theme', dark ? 'dark' : 'light');
      btn.setAttribute('aria-pressed', String(dark));
      btn.setAttribute('aria-label', dark ? 'Switch to light theme' : 'Switch to dark theme');
      var meta = document.querySelector('meta[name="theme-color"]');
      if (meta) meta.setAttribute('content', dark ? '#080616' : '#EBE9DD');
      // Let React islands (BlockNote editor) react to the theme change.
      document.dispatchEvent(new CustomEvent('themechange', { detail: { dark: dark } }));
    }
    var saved = null;
    try {
      saved = localStorage.getItem(KEY);
    } catch (e) {}
    // Dark is the default for reading a post — only an explicit 'light' opts out.
    apply(saved !== 'light');
    btn.addEventListener('click', function () {
      var dark = root.getAttribute('data-theme') !== 'dark';
      apply(dark);
      try {
        localStorage.setItem(KEY, dark ? 'dark' : 'light');
      } catch (e) {}
    });
  })();
</script>
