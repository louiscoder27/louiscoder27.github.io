# Copy to `.env` and fill in. On Vercel, add the same keys under
# Project Settings -> Environment Variables.
#
# NEVER put real keys in this file — it IS committed to git. Real values go in
# `.env` (gitignored).

# From Supabase: Project Settings -> API
PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
PUBLIC_SUPABASE_ANON_KEY=eyJhbGci...

# Service-role key: ONLY used by scripts/seed-posts.mjs (server-side).
# Never expose this to the browser or commit it.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGci...

# The deployed site URL (used for magic-link redirects + sitemap).
PUBLIC_SITE_URL=https://your-project.vercel.app

# Only this email is allowed into /admin.
ADMIN_EMAIL=louistr2706@gmail.com
