---
// Stat-Led signature block — prominent tabular figures with a count-up reveal.
// Every figure is passed in from real data (post count, category count, years active);
// no invented metrics.
interface Stat {
  value: number;
  suffix?: string;
  label: string;
  note?: string;
}
interface Props {
  stats: Stat[];
}
const { stats } = Astro.props;
---

<section class="stats" aria-label="At a glance">
  <div class="page">
    <hr class="stats__rule" aria-hidden="true" />
    <dl class="stats__grid">
      {
        stats.map((s) => (
          <div class="stats__item">
            <dd class="stats__figure tnum">
              <span
                class="stats__num"
                data-countup
                data-target={s.value}
              >{s.value}</span>{s.suffix && <span class="stats__suffix">{s.suffix}</span>}
            </dd>
            <dt class="stats__label">{s.label}</dt>
            {s.note && <p class="stats__note">{s.note}</p>}
          </div>
        ))
      }
    </dl>
    <hr class="stats__rule" aria-hidden="true" />
  </div>
</section>

<style>
  .stats__rule {
    border: 0;
    border-top: var(--rule-hair) solid var(--color-rule);
    margin: 0;
  }
  .stats__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    margin: 0;
  }
  .stats__item {
    padding: var(--space-lg) var(--space-md);
    border-right: var(--rule-hair) solid var(--color-rule);
  }
  .stats__item:last-child {
    border-right: 0;
  }
  .stats__figure {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: var(--text-stat);
    line-height: 1;
    letter-spacing: -0.03em;
    color: var(--color-accent);
    display: flex;
    align-items: baseline;
  }
  .stats__suffix {
    font-size: 0.42em;
    font-weight: 700;
    margin-left: 0.15em;
    color: var(--color-ink-2);
  }
  .stats__label {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: var(--text-sm);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-ink);
    margin-top: var(--space-sm);
  }
  .stats__note {
    font-size: var(--text-sm);
    font-style: italic;
    color: var(--color-muted);
    margin-top: var(--space-3xs);
  }

  @media (max-width: 620px) {
    .stats__grid {
      grid-template-columns: 1fr;
    }
    .stats__item {
      border-right: 0;
      border-bottom: var(--rule-hair) solid var(--color-rule);
      padding-block: var(--space-md);
    }
    .stats__item:last-child {
      border-bottom: 0;
    }
  }
</style>

<script>
  // Count-up reveal — the one orchestrated entrance for the stat figures.
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const nums = document.querySelectorAll<HTMLElement>('[data-countup]');

  const run = (el: HTMLElement) => {
    const target = Number(el.dataset.target ?? '0');
    if (reduce || target <= 0) {
      el.textContent = String(target);
      return;
    }
    const duration = 520;
    const start = performance.now();
    const tick = (now: number) => {
      const p = Math.min((now - start) / duration, 1);
      // ease-out cubic
      const eased = 1 - Math.pow(1 - p, 3);
      el.textContent = String(Math.round(eased * target));
      if (p < 1) requestAnimationFrame(tick);
      else el.textContent = String(target);
    };
    requestAnimationFrame(tick);
  };

  if ('IntersectionObserver' in window && !reduce) {
    const io = new IntersectionObserver(
      (entries, obs) => {
        entries.forEach((e) => {
          if (e.isIntersecting) {
            run(e.target as HTMLElement);
            obs.unobserve(e.target);
          }
        });
      },
      { threshold: 0.4 },
    );
    nums.forEach((n) => io.observe(n));
  } else {
    nums.forEach((n) => run(n));
  }
</script>
