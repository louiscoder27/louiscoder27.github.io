---
// N6 · Newspaper masthead — centred wordmark, edition line, nav row, double rule.
import { SITE } from '../site.config';

const base = import.meta.env.BASE_URL;
const withBase = (p: string) => `${base}${p}`.replace(/\/{2,}/g, '/');
const current = Astro.url.pathname.replace(/\/+$/, '') || '/';

// The standalone About page was removed — About now lives as a section on the
// home page, so the nav links to that anchor.
const nav = [
  { label: 'Home', href: withBase('/') },
  { label: 'Blog', href: withBase('/blog') },
  { label: 'About', href: `${withBase('/')}#about` },
];

const isActive = (href: string) => {
  const clean = href.replace(/\/+$/, '') || '/';
  if (clean === (base.replace(/\/+$/, '') || '/')) return current === clean;
  return current === clean || current.startsWith(clean + '/');
};
---

<header class="mast">
  <div class="page mast__inner">
    <p class="mast__edition">{SITE.edition}</p>
    <a class="mast__name" href={withBase('/')}>{SITE.title}</a>
    <p class="mast__kicker">{SITE.kicker}</p>
    <nav class="mast__nav" aria-label="Primary">
      <ul>
        {
          nav.map((item) => (
            <li>
              <a
                href={item.href}
                class:list={['mast__link', { 'is-active': isActive(item.href) }]}
                aria-current={isActive(item.href) ? 'page' : undefined}
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
  <hr class="mast__rule" aria-hidden="true" />
</header>

<style>
  .mast {
    background: var(--color-paper);
  }
  .mast__inner {
    display: grid;
    justify-items: center;
    text-align: center;
    gap: var(--space-3xs);
    padding-block: var(--space-md) var(--space-2xs);
  }
  .mast__edition {
    font-family: var(--font-display);
    font-size: var(--text-xs);
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-muted);
  }
  .mast__name {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(2rem, 6vw, 3.5rem);
    letter-spacing: -0.02em;
    line-height: 0.98;
    color: var(--color-ink);
    text-transform: uppercase;
  }
  .mast__kicker {
    font-family: var(--font-body);
    font-style: italic;
    font-size: var(--text-sm);
    color: var(--color-ink-2);
  }
  .mast__nav ul {
    display: inline-flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: clamp(1rem, 5vw, 2.5rem);
    list-style: none;
    padding: 0;
    margin: var(--space-2xs) 0 var(--space-3xs);
  }
  .mast__link {
    font-family: var(--font-display);
    font-size: var(--text-sm);
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-ink-2);
    white-space: nowrap;
    padding-bottom: 3px;
    border-bottom: 2px solid transparent;
    transition: color var(--dur-short) var(--ease-out),
      border-color var(--dur-short) var(--ease-out);
  }
  .mast__link:hover {
    color: var(--color-accent);
  }
  .mast__link.is-active {
    color: var(--color-accent);
    border-bottom-color: var(--color-accent);
  }
  .mast__rule {
    border: 0;
    border-top: var(--rule-hair) solid var(--color-ink);
    border-bottom: var(--rule-hair) solid var(--color-ink);
    height: 3px;
    margin: 0;
    opacity: 0.85;
  }
</style>
