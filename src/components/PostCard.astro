---
// Editorial list row for a post (not an icon-tile card). Hairline-separated,
// title in display sans, dek in body serif, subtle hover lift.
import { categorySlug } from '../lib/categories';
import type { Category } from '../content.config';

interface Props {
  title: string;
  description: string;
  pubDate: Date;
  category: Category;
  slug: string;
  readingTime?: string;
}
const { title, description, pubDate, category, slug, readingTime } = Astro.props;

const base = import.meta.env.BASE_URL;
const withBase = (p: string) => `${base}${p}`.replace(/\/{2,}/g, '/');
const href = withBase(`/blog/${slug}`);
const catHref = withBase(`/category/${categorySlug(category)}`);

const dateLabel = pubDate.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'short',
  day: 'numeric',
});
const dateISO = pubDate.toISOString();
---

<article class="card">
  <div class="card__meta">
    <a class="card__cat" href={catHref}>{category}</a>
    <time class="card__date tnum" datetime={dateISO}>{dateLabel}</time>
    {readingTime && <span class="card__read">{readingTime}</span>}
  </div>
  <h3 class="card__title">
    <a href={href}>{title}</a>
  </h3>
  <p class="card__dek">{description}</p>
</article>

<style>
  .card {
    padding-block: var(--space-md);
    border-top: var(--rule-hair) solid var(--color-rule);
  }
  .card__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-2xs) var(--space-sm);
    margin-bottom: var(--space-2xs);
    font-family: var(--font-display);
    font-size: var(--text-xs);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .card__cat {
    font-weight: 700;
    color: var(--color-accent);
    white-space: nowrap;
  }
  .card__cat:hover {
    color: var(--color-accent-strong);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .card__date,
  .card__read {
    color: var(--color-muted);
    font-weight: 500;
  }
  .card__title {
    font-size: var(--text-lg);
    line-height: 1.15;
    letter-spacing: -0.015em;
  }
  .card__title a {
    color: var(--color-ink);
    transition: color var(--dur-short) var(--ease-out);
  }
  .card__title a:hover {
    color: var(--color-accent);
  }
  .card__dek {
    margin-top: var(--space-2xs);
    max-width: 60ch;
    color: var(--color-ink-2);
    line-height: 1.6;
  }
</style>
