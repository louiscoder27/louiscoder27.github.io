---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../site.config';

const base = import.meta.env.BASE_URL;
const withBase = (p: string) => `${base}${p}`.replace(/\/{2,}/g, '/');
---

<BaseLayout
  title="About"
  description={`About ${SITE.author} and this journal on economics, markets, and investing.`}
>
  <section class="about">
    <div class="page">
      <header class="about__head">
        <p class="eyebrow">About</p>
        <h1 class="about__title">Why I write this</h1>
      </header>

      <div class="prose about__body">
        <p>
          I'm {SITE.author}. This is my personal notebook for thinking out loud about
          business, the economy, and investing. I started it because the best way I know to
          test whether I understand something is to try to explain it in plain English — no
          jargon, no forecasts dressed up as facts.
        </p>
        <p>Everything here falls into one of three sections:</p>
        <ul>
          <li>
            <strong>Business Analysis</strong> — reading a company from its filings out:
            unit economics, moats, capital allocation, and what the numbers leave unsaid.
          </li>
          <li>
            <strong>Macro</strong> — rates, inflation, growth, and liquidity: the weather
            system every portfolio has to sail through.
          </li>
          <li>
            <strong>Personal Investing</strong> — building a portfolio I can actually hold:
            position sizing, temperament, fees, and the slow work of compounding.
          </li>
        </ul>
        <p>
          Nothing here is investment advice — it's one person working through ideas in
          public. If something is wrong, I'd genuinely like to know.
        </p>

        <h2>Get in touch</h2>
        <p>
          The fastest way to reach me is email. I read everything, even if replies take a
          few days.
        </p>
        <ul class="about__contact">
          {
            SITE.links.map((l) => (
              <li>
                <a class="link" href={l.href}>{l.label}</a>
              </li>
            ))
          }
        </ul>
      </div>

      <p class="about__cta">
        <a class="chip" href={withBase('/blog')}>Read the essays <span aria-hidden="true">→</span></a>
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  .about {
    padding-block: var(--space-xl) 0;
  }
  .about__title {
    font-size: var(--text-3xl);
    letter-spacing: -0.025em;
    margin-top: var(--space-2xs);
  }
  .about__body {
    margin-top: var(--space-lg);
  }
  .about__contact {
    list-style: none;
    padding-left: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-md);
  }
  .about__cta {
    margin-top: var(--space-xl);
  }
</style>
