---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import { CATEGORY_META } from '../../lib/categories';
import { CATEGORIES } from '../../content.config';
import type { Category } from '../../content.config';
import { getPosts } from '../../lib/posts';

export async function getStaticPaths() {
  const posts = await getPosts();
  return (CATEGORIES as readonly Category[]).map((category) => ({
    params: { category: CATEGORY_META[category].slug },
    props: {
      category,
      posts: posts.filter((p) => p.data.category === category),
    },
  }));
}

interface Props {
  category: Category;
  posts: Awaited<ReturnType<typeof getPosts>>;
}
const { category, posts } = Astro.props;
const meta = CATEGORY_META[category];

const base = import.meta.env.BASE_URL;
const withBase = (p: string) => `${base}${p}`.replace(/\/{2,}/g, '/');
---

<BaseLayout title={category} description={meta.blurb}>
  <section class="cat-page">
    <div class="page">
      <p class="cat-page__crumbs">
        <a class="link" href={withBase('/blog')}>Blog</a>
        <span aria-hidden="true">/</span>
        <span>{category}</span>
      </p>
      <header class="cat-page__head">
        <h1 class="cat-page__title">{category}</h1>
        <p class="cat-page__blurb">{meta.blurb}</p>
        <p class="cat-page__count">
          {posts.length} {posts.length === 1 ? 'essay' : 'essays'} in this section
        </p>
      </header>

      {
        posts.length > 0 ? (
          <div class="cat-page__list">
            {posts.map((post) => (
              <PostCard
                title={post.data.title}
                description={post.data.description}
                pubDate={post.data.pubDate}
                category={post.data.category}
                slug={post.id}
                readingTime={post.data.readingTime}
              />
            ))}
          </div>
        ) : (
          <p class="cat-page__empty">
            Nothing here yet — the first essay in this section is on its way.
          </p>
        )
      }
    </div>
  </section>
</BaseLayout>

<style>
  .cat-page {
    padding-block: var(--space-xl) 0;
  }
  .cat-page__crumbs {
    display: flex;
    gap: var(--space-2xs);
    font-family: var(--font-display);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-muted);
  }
  .cat-page__head {
    max-width: 46rem;
    margin-top: var(--space-md);
    padding-bottom: var(--space-md);
    border-bottom: 2px solid var(--color-ink);
  }
  .cat-page__title {
    font-size: var(--text-3xl);
    letter-spacing: -0.025em;
  }
  .cat-page__blurb {
    margin-top: var(--space-sm);
    font-size: var(--text-md);
    line-height: 1.55;
    color: var(--color-ink-2);
  }
  .cat-page__count {
    margin-top: var(--space-md);
    font-family: var(--font-display);
    font-size: var(--text-sm);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-muted);
  }
  .cat-page__list :global(.card:first-child) {
    border-top: 0;
  }
  .cat-page__empty {
    margin-top: var(--space-md);
    font-style: italic;
    color: var(--color-ink-2);
  }
</style>
