---
import BaseLayout from '../layouts/BaseLayout.astro';
import IntroStage from '../components/IntroStage.astro';
import StatStrip from '../components/StatStrip.astro';
import PostCard from '../components/PostCard.astro';
import CategoryCards from '../components/CategoryCards.astro';
import { SITE } from '../site.config';
import { CATEGORIES } from '../content.config';
import { getPosts, countByCategory, yearsActive } from '../lib/posts';

const posts = await getPosts();
const latest = posts.slice(0, 4);
const counts = countByCategory(posts);
const years = yearsActive(posts, SITE.sinceYear);
const firstYear = posts.length
  ? Math.min(...posts.map((p) => p.data.pubDate.getFullYear()))
  : SITE.sinceYear;

const base = import.meta.env.BASE_URL;
const withBase = (p: string) => `${base}${p}`.replace(/\/{2,}/g, '/');

const stats = [
  { value: posts.length, label: 'Essays published', note: 'and counting' },
  {
    value: CATEGORIES.length,
    label: 'Sections tracked',
    note: 'business · macro · investing',
  },
  { value: years, label: 'Years writing', note: `since ${firstYear}` },
];
---

<BaseLayout showMasthead={false}>
  <IntroStage />

  <StatStrip stats={stats} />

  <section class="latest" aria-labelledby="latest-heading">
    <div class="page">
      <div class="latest__head">
        <h2 id="latest-heading" class="latest__title">Latest essays</h2>
        <a class="latest__all link" href={withBase('/blog')}>View all →</a>
      </div>
      {
        latest.length > 0 ? (
          <div class="latest__list">
            {latest.map((post) => (
              <PostCard
                title={post.data.title}
                description={post.data.description}
                pubDate={post.data.pubDate}
                category={post.data.category}
                slug={post.id}
                readingTime={post.data.readingTime}
              />
            ))}
          </div>
        ) : (
          <p class="latest__empty">
            No essays yet — the first one is being written. Check back soon.
          </p>
        )
      }
    </div>
  </section>

  <CategoryCards heading="Sections" counts={counts} />
</BaseLayout>

<style>
  .latest {
    padding-block: var(--space-xl) 0;
  }
  .latest__head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-md);
    padding-bottom: var(--space-sm);
    border-bottom: 2px solid var(--color-ink);
  }
  .latest__title {
    font-size: var(--text-xl);
    letter-spacing: -0.02em;
  }
  .latest__all {
    font-family: var(--font-display);
    font-size: var(--text-sm);
    font-weight: 600;
    white-space: nowrap;
  }
  .latest__list {
    margin-top: var(--space-2xs);
  }
  /* First row's top hairline is redundant against the section rule above it. */
  .latest__list :global(.card:first-child) {
    border-top: 0;
  }
  .latest__empty {
    margin-top: var(--space-md);
    color: var(--color-ink-2);
    font-style: italic;
  }
</style>
