---
// Base document — fonts, tokens, global styles, masthead + footer chrome.
import '@fontsource-variable/libre-franklin';
import '@fontsource-variable/libre-franklin/wght-italic.css';
import '@fontsource-variable/source-serif-4';
import '../styles/tokens.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE } from '../site.config';

interface Props {
  title?: string;
  description?: string;
  // Home passes false: the full-screen hero replaces the masthead there.
  showMasthead?: boolean;
}

const { title, description, showMasthead = true } = Astro.props;
const pageTitle = title ? `${title} · ${SITE.title}` : `${SITE.title} — ${SITE.kicker}`;
const pageDescription = description ?? SITE.description;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <meta name="author" content={SITE.author} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#f4efe4" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={canonical} />

    <link rel="icon" href={`${import.meta.env.BASE_URL}favicon.svg`} type="image/svg+xml" />
    <link rel="sitemap" href={`${import.meta.env.BASE_URL}sitemap-index.xml`} />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    {showMasthead && <Header />}
    <main id="main">
      <slot />
    </main>
    <Footer />

    <style>
      #main {
        flex: 1 0 auto;
      }
      .skip-link {
        position: absolute;
        left: var(--space-sm);
        top: -3rem;
        z-index: var(--z-overlay);
        background: var(--color-accent);
        color: var(--color-accent-ink);
        padding: 0.5rem 0.9rem;
        border-radius: var(--radius-sm);
        font-family: var(--font-display);
        font-size: var(--text-sm);
        transition: top var(--dur-short) var(--ease-out);
      }
      .skip-link:focus {
        top: var(--space-sm);
      }
    </style>
  </body>
</html>
